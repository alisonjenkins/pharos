<?xml version="1.0" encoding="utf-8"?>
<!-- 025: the TV manifest dx's template cannot express
     (LEANBACK_LAUNCHER, banner, touchscreen not required), and the label:
     its app_name is the bin name in Pascal case, "PharosTv". -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application android:hasCode="true" android:icon="@mipmap/ic_launcher"
        android:banner="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowNativeHeapPointerTagging="false"
        android:label="Pharos"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- B1323: every change a TV can make while the app runs (a keyboard
             or remote attached, the panel's mode or density) is handled in
             place; a recreated NativeActivity came back with a dark window
             and no page. -->
        <activity android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" android:exported="true"
            android:label="Pharos" android:name="dev.dioxus.main.MainActivity">
            <meta-data android:name="android.app.lib_name" android:value="main" />
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
