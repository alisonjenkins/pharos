<resources>
    <!-- The app theme: dark, so the window shows Pharos Night (#0e1116)
         before the WebView paints, not AppCompat.Light's white. -->
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/pharos_night</item>
        <item name="android:colorBackground">@color/pharos_night</item>
    </style>
    <color name="pharos_night">#0E1116</color>
</resources>
