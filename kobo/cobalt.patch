+    std::fs::create_dir(&staging).unwrap();
+    assert!(downloads.begin("shelf", URL, Some(4_000), BLOCK).is_none());
+    let held = downloads.progress("shelf", &[URL.to_owned()]);
+    assert_eq!((held[0].have, held[0].total), (u64::from(BLOCK), 3_000));
+    assert_eq!(old.read(0).unwrap(), block(0, 3_000));
+    std::fs::remove_dir(&staging).unwrap();
+    drop(old);
+    let reopened = downloads.begin("shelf", URL, None, BLOCK).expect("kept");
+    assert!(reopened.has(0));
+    assert_eq!(reopened.read(0).unwrap(), block(0, 3_000));
