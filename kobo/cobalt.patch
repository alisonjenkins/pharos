+#[test]
+fn a_book_is_downloaded_whole_then_opens_with_no_network() {
+    let dir = scratch("whole");
+    let (_card, policy) = Card::policy(u64::MAX, 0);
+    let (downloads, lines) = downloads(&dir, policy);
+    let bytes = pattern(10_000);
+    let log = Arc::new(Mutex::new(Vec::new()));
+    let store = downloads.begin("shelf", URL, Some(10_000), BLOCK).unwrap();
+    let remote = Remote::open_stored(
+        served(Arc::clone(&bytes), Arc::clone(&log)),
+        store,
+        Vec::new(),
+        quick(BLOCK),
+    )
+    .unwrap();
+    let mut first = vec![0; 100];
+    remote.reader().read_exact(&mut first).unwrap();
+    assert_eq!(first, bytes[..100]);
+    // Nobody asked for the rest: the download fetches it.
+    eventually("the download completes", || {
+        downloads.stats().completed == 1
+    });
+    drop(remote);
+
+    let after = downloads.stats();
+    assert_eq!((after.started, after.completed), (1, 1));
+    assert_eq!(after.bytes_written, 10_000);
+    assert!(said(&lines, "downloads: start"));
+    assert!(said(&lines, "downloads: complete"));
+
+    // The same book with a new token, offline: no request may be made.
+    let calls = Arc::new(AtomicU64::new(0));
+    let store = downloads
+        .begin(
+            "shelf",
+            "https://books.example/Audio/aaa/universal?api_key=new&static=true",
+            None,
+            BLOCK,
+        )
+        .unwrap();
+    assert!(store.is_complete());
+    let remote =
