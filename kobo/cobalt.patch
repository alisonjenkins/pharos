+//! A book read off the shelf a range at a time, rather than all at once.
+//!
+//! A large illustrated book is mostly pictures, and the reader holds a few
+//! hundred megabytes of memory at most. Loading the file whole put a ceiling
+//! on the books that open at all, and spent the time and memory of reading
+//! every plate before the first page was drawn. So the book's end record and
+//! directory are read first, then only the members that text is made of, and
+//! each picture is measured from its first bytes; its whole is read when the
+//! reader comes near it.
+//!
+//! Everything here is plain bookkeeping over answers, with no [`Context`] in
+//! it, so that the sequence can be driven and checked without a runtime. The
+//! view sends the reads it asks for and hands back what comes.
+//!
+//! [`Context`]: kobo_sdk::Context
+
+use std::collections::{BTreeMap, VecDeque};
+
+use kobo_doc::zip::{self, Location, Pieces};
+use kobo_doc::Document;
+use kobo_sdk::{StoreError, MAX_SHELF_CHUNK};
+
+/// The first bytes read of a book: enough to know it is an archive, and the
+/// size of the whole from the answer.
+const HEAD: usize = 4;
+
+/// The most a book's central directory may run to.
+///
+/// One entry is some sixty bytes, and an archive is read to eight thousand of
+/// them, so a real directory is half a megabyte at worst. More than this is a
+/// damaged or hostile end record.
+const MAX_DIRECTORY: usize = 8 * 1024 * 1024;
+
+/// The most the text, styles and fonts of one book may come to.
+///
+/// What is held in memory while the book is open; the pictures are not in it.
+/// A long novel's text is a megabyte or two, and embedded fonts a few more.
+const MAX_TEXT: usize = 64 * 1024 * 1024;
+
+/// How much of a picture is read to learn its size.
+///
+/// A PNG states it in its first thirty bytes and a JPEG within its first few
+/// kilobytes, unless a camera wrote a thumbnail or a colour profile ahead of
+/// it; then the whole picture is read instead.
+pub(crate) const MEASURE: usize = 32 * 1024;
+
+/// The most one picture's stored bytes may span on the card.
+///
+/// Above the two megabytes a picture may unpack to, because a member's span
+/// carries its header and, sometimes, a trailing descriptor.
+pub(crate) const MAX_PICTURE_SPAN: usize = 4 * 1024 * 1024;
+
+/// Why a book on the shelf would not open.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum ShelfFault {
+    /// The shelf refused a read, or answered with something other than what
+    /// was asked for.
+    Store(StoreError),
+    /// The file is not a readable book.
+    Book(kobo_doc::epub::Fault),
+    /// The book's text, styles and fonts together are more than the reader
+    /// will hold.
+    TooLarge {
+        /// What they come to.
+        bytes: usize,
+    },
+}
+
+impl std::fmt::Display for ShelfFault {
+    fn fmt(&self, out: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Store(error) => write!(out, "the shelf would not read the book: {error:?}"),
+            Self::Book(fault) => fault.fmt(out),
+            Self::TooLarge { bytes } => write!(
+                out,
+                "the book's text is {bytes} bytes, and {MAX_TEXT} is the most that is held"
+            ),
+        }
+    }
+}
+
+impl std::error::Error for ShelfFault {}
+
+impl From<kobo_doc::epub::Fault> for ShelfFault {
+    fn from(fault: kobo_doc::epub::Fault) -> Self {
+        Self::Book(fault)
+    }
+}
+
+impl From<zip::Fault> for ShelfFault {
+    fn from(fault: zip::Fault) -> Self {
+        Self::Book(fault.into())
+    }
+}
+
+/// One range of a blob, read in as many pieces as the shelf allows.
+#[derive(Clone, Debug)]
+pub(crate) struct Span {
+    at: usize,
+    until: usize,
+    bytes: Vec<u8>,
+}
+
+impl Span {
+    pub(crate) fn new(at: usize, until: usize) -> Self {
+        Self {
+            at,
+            until: until.max(at),
+            bytes: Vec::new(),
+        }
+    }
+
+    /// The next read to ask for, as an offset and a length.
+    pub(crate) fn request(&self) -> (u32, u32) {
+        let from = self.at + self.bytes.len();
+        let length = (self.until - from).min(MAX_SHELF_CHUNK);
+        (
+            u32::try_from(from).unwrap_or(u32::MAX),
+            u32::try_from(length).unwrap_or(u32::MAX),
+        )
+    }
+
+    /// Takes one answer, and says whether the range is now whole.
+    ///
+    /// # Errors
+    ///
+    /// [`StoreError::Missing`] for a piece that does not begin where the last
+    /// one ended, runs past what was asked, or comes back empty before the
+    /// end: any of them would splice together bytes that are not the file.
+    pub(crate) fn take(&mut self, offset: u32, bytes: &[u8]) -> Result<bool, StoreError> {
+        let (expected, length) = self.request();
+        if offset != expected
+            || bytes.len() > usize::try_from(length).unwrap_or(usize::MAX)
+            || (bytes.is_empty() && length > 0)
+        {
+            return Err(StoreError::Missing);
+        }
+        self.bytes.extend_from_slice(bytes);
+        Ok(self.done())
+    }
+
+    pub(crate) fn done(&self) -> bool {
+        self.at + self.bytes.len() >= self.until
+    }
+
+    pub(crate) const fn at(&self) -> usize {
+        self.at
+    }
+
+    pub(crate) fn into_bytes(self) -> Vec<u8> {
+        self.bytes
+    }
+}
+
+/// What an [`Opening`] wants next.
+#[derive(Debug)]
+pub(crate) enum Next {
+    /// Read this, and hand the answer back.
+    Read(u32, u32),
+    /// The book is open, with each picture's size and place, and the size
+    /// of the whole blob.
+    Done(Document, BTreeMap<String, ((u32, u32), Location)>, usize),
+}
+
+#[derive(Debug)]
+enum Stage {
+    Head,
+    Tail,
+    /// The directory starts before the tail did, and is being read up to it.
+    Directory {
+        tail_at: usize,
+        tail: Vec<u8>,
+    },
+    Members,
+    /// Measuring one picture, from its first bytes or, failing that, all of
+    /// them.
+    Measure {
+        name: String,
+        place: Location,
+        whole: bool,
+    },
+}
+
+/// A book being opened from the shelf.
+#[derive(Debug)]
+pub(crate) struct Opening {
+    stage: Stage,
+    span: Span,
+    size: usize,
+    pieces: Pieces,
+    members: VecDeque<(usize, usize)>,
+    document: Option<Document>,
+    unmeasured: VecDeque<(String, Location)>,
+    measured: BTreeMap<String, ((u32, u32), Location)>,
+}
+
+impl Opening {
+    /// Starts, returning the first read to ask for.
+    pub(crate) fn start() -> (Self, (u32, u32)) {
+        let opening = Self {
+            stage: Stage::Head,
+            span: Span::new(0, HEAD),
+            size: 0,
+            pieces: Pieces::default(),
+            members: VecDeque::new(),
+            document: None,
+            unmeasured: VecDeque::new(),
+            measured: BTreeMap::new(),
+        };
+        let first = opening.span.request();
+        (opening, first)
+    }
+
+    /// Takes one read's answer.
+    ///
+    /// # Errors
+    ///
+    /// Whatever stops the book opening. The opening is over once one is
+    /// returned.
+    pub(crate) fn answer(
+        &mut self,
+        offset: u32,
+        bytes: &[u8],
+        size: u32,
+    ) -> Result<Next, ShelfFault> {
+        let size = usize::try_from(size).unwrap_or(usize::MAX);
+        if matches!(self.stage, Stage::Head) {
+            self.size = size;
+        } else if size != self.size {
+            // The file changed under the reads, which would make the parts
+            // pieces of two different books.
+            return Err(ShelfFault::Store(StoreError::Missing));
+        }
+        if !self.span.take(offset, bytes).map_err(ShelfFault::Store)? {
+            let (offset, length) = self.span.request();
+            return Ok(Next::Read(offset, length));
+        }
+        let span = std::mem::replace(&mut self.span, Span::new(0, 0));
+        let at = span.at();
+        let bytes = span.into_bytes();
+        match std::mem::replace(&mut self.stage, Stage::Members) {
+            Stage::Head => self.headed(&bytes),
+            Stage::Tail => self.tailed(at, bytes),
+            Stage::Directory { tail_at, tail } => {
+                self.pieces.insert(at, bytes);
+                self.pieces.insert(tail_at, tail);
+                self.directed()
+            }
+            Stage::Members => {
+                self.pieces.insert(at, bytes);
+                self.next_member()
+            }
+            Stage::Measure { name, place, whole } => Ok(self.measuring(name, place, whole, &bytes)),
+        }
+    }
+
+    fn begin(&mut self, stage: Stage, at: usize, until: usize) -> Next {
+        self.stage = stage;
+        self.span = Span::new(at, until);
+        let (offset, length) = self.span.request();
+        Next::Read(offset, length)
+    }
+
+    fn headed(&mut self, head: &[u8]) -> Result<Next, ShelfFault> {
+        if head != b"PK\x03\x04" {
+            return Err(zip::Fault::NotAnArchive.into());
+        }
+        self.pieces = Pieces::new(self.size);
+        let tail_at = self.size.saturating_sub(zip::MAX_TAIL);
+        Ok(self.begin(Stage::Tail, tail_at, self.size))
+    }
+
+    fn tailed(&mut self, tail_at: usize, tail: Vec<u8>) -> Result<Next, ShelfFault> {
+        let (at, len) = zip::directory_of(&tail, tail_at)?;
+        if len > MAX_DIRECTORY {
+            return Err(zip::Fault::TooLarge.into());
+        }
+        if at >= tail_at {
+            self.pieces.insert(tail_at, tail);
+            return self.directed();
+        }
+        // From the directory to the tail, so no entry straddles two reads. Its
+        // own length bounds the read: an end record that points the directory
+        // far back must not make the whole file be read to find it.
+        let until = tail_at.min(at.saturating_add(len));
+        Ok(self.begin(Stage::Directory { tail_at, tail }, at, until))
+    }
+
+    fn directed(&mut self) -> Result<Next, ShelfFault> {
+        let archive = zip::Archive::open_pieces(&self.pieces)?;
+        let needed: Vec<Location> = archive
+            .locations()
+            .filter(|(name, _)| kobo_doc::epub::needed_to_open(name))
+            .map(|(_, place)| place)
+            .collect();
+        // What the members come to once unpacked is what is held; a member
+        // is unpacked to no more than it declares, so this bounds it.
+        let unpacked = needed
+            .iter()
+            .fold(0_usize, |sum, place| sum.saturating_add(place.unpacked()));
+        if unpacked > MAX_TEXT {
+            return Err(ShelfFault::TooLarge { bytes: unpacked });
+        }
+        let mut ranges: Vec<(usize, usize)> =
+            needed.iter().map(|place| (place.at, place.end)).collect();
+        ranges.sort_unstable();
+        let mut members: Vec<(usize, usize)> = Vec::new();
+        for (at, end) in ranges {
+            match members.last_mut() {
+                Some((_, last)) if at <= *last => *last = (*last).max(end),
+                _ => members.push((at, end)),
+            }
+        }
+        let bytes: usize = members.iter().map(|(at, end)| end - at).sum();
+        if bytes > MAX_TEXT {
+            return Err(ShelfFault::TooLarge { bytes });
+        }
+        self.members = members.into();
+        self.next_member()
+    }
+
+    fn next_member(&mut self) -> Result<Next, ShelfFault> {
+        if let Some((at, end)) = self.members.pop_front() {
+            return Ok(self.begin(Stage::Members, at, end));
+        }
+        let mut document = kobo_doc::epub::parse_pieces(&self.pieces)?;
+        // The text's parts are the book from here; the pictures are read off
+        // the card as they are wanted.
+        self.pieces = Pieces::default();
+        self.unmeasured = std::mem::take(&mut document.places).into_iter().collect();
+        self.document = Some(document);
+        Ok(self.next_measure())
+    }
+
+    fn next_measure(&mut self) -> Next {
+        while let Some((name, place)) = self.unmeasured.pop_front() {
+            if place.end.saturating_sub(place.at) > MAX_PICTURE_SPAN {
+                continue;
+            }
+            let until = place.end.min(place.at + MEASURE);
+            return self.begin(
+                Stage::Measure {
+                    name,
+                    place,
+                    whole: until == place.end,
+                },
+                place.at,
+                until,
+            );
+        }
+        let document = self.document.take().unwrap_or_default();
+        Next::Done(document, std::mem::take(&mut self.measured), self.size)
+    }
+
+    fn measuring(&mut self, name: String, place: Location, whole: bool, bytes: &[u8]) -> Next {
+        let measured = zip::unpack_prefix(bytes, &place, usize::MAX)
+            .ok()
+            .and_then(|picture| kobo_image::size(&picture).ok());
+        match measured {
+            Some(size) => {
+                self.measured.insert(name, (size, place));
+            }
+            None if !whole => {
+                let (at, end) = (place.at, place.end);
+                return self.begin(
+                    Stage::Measure {
+                        name,
+                        place,
+                        whole: true,
+                    },
+                    at,
+                    end,
+                );
+            }
+            // A picture whose header will not read reads as its description.
+            None => {}
+        }
+        self.next_measure()
+    }
+}
