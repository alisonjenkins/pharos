+    meta.set(9);
+    assert_eq!(Meta::decode(&meta.encode()), Some(meta.clone()));
+    assert_eq!(meta.have_bytes(), 1_024 + (10_000 - 9 * 1_024));
+    assert_eq!(Meta::decode("pharos-download 1\ntotal=10\n"), None);
+    assert_eq!(
+        Meta::decode(&meta.encode().replace("bits=", "bits=00")),
+        None
+    );
+    assert_eq!(Meta::decode("garbage"), None);
+}
