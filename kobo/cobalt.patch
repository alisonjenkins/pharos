+#[test]
+fn a_partial_download_survives_a_restart_and_fetches_only_the_rest() {
+    let dir = scratch("restart");
+    let (_card, policy) = Card::policy(u64::MAX, 0);
+    let bytes = pattern(10_000);
+    {
+        let (downloads, _lines) = downloads(&dir, policy.clone());
+        // A server that goes away after five blocks.
+        let good = served(Arc::clone(&bytes), Arc::default());
+        let served_blocks = Arc::new(AtomicU64::new(0));
+        let fetch: RangeFetch = {
+            let served_blocks = Arc::clone(&served_blocks);
+            Arc::new(move |offset, len| {
+                if served_blocks.fetch_add(1, Ordering::SeqCst) < 5 {
+                    good(offset, len)
+                } else {
+                    Err(FetchFailure::Transient)
+                }
+            })
+        };
+        let store = downloads.begin("shelf", URL, Some(10_000), BLOCK).unwrap();
+        let remote = Remote::open_stored(fetch, store, Vec::new(), quick(BLOCK)).unwrap();
+        let mut head = vec![0; 10];
+        remote.reader().read_exact(&mut head).unwrap();
+        eventually("five blocks land", || downloads.stats().blocks_written >= 5);
+    }
+
+    // The process "restarts": a new Downloads over the same folder. The old
+    // book saves its place when its last thread lets go of it.
+    let (downloads, lines) = downloads(&dir, policy);
+    eventually("the first run saves its place", || {
+        downloads
+            .progress("shelf", &[URL.to_owned()])
+            .first()
+            .is_some_and(|progress| progress.have == 5 * 1_024)
+    });
+    let progress = downloads.progress("shelf", &[URL.to_owned()]);
+    assert_eq!(progress.len(), 1);
+    assert_eq!((progress[0].have, progress[0].total), (5 * 1_024, 10_000));
+    let log = Arc::new(Mutex::new(Vec::new()));
+    let store = downloads.begin("shelf", URL, Some(10_000), BLOCK).unwrap();
+    assert!(said(&lines, "downloads: resume"));
+    let remote = Remote::open_stored(
+        served(Arc::clone(&bytes), Arc::clone(&log)),
+        store,
+        Vec::new(),
+        quick(BLOCK),
+    )
+    .unwrap();
+    let mut all = Vec::new();
+    remote.reader().read_to_end(&mut all).unwrap();
+    assert_eq!(all, *bytes);
+    eventually("the download completes", || {
+        downloads.stats().completed == 1
+    });
+    let asked = log.lock().unwrap().clone();
+    assert!(
+        asked.iter().all(|offset| *offset >= 5 * 1_024),
+        "refetched a block already on disk: {asked:?}"
+    );
+}
