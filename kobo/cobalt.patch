+    /// `book` with the central directory claiming `claimed` bytes unpacked for
+    /// each of the named members.
+    fn claiming_to_unpack(mut book: Vec<u8>, names: &[&str], claimed: u32) -> Vec<u8> {
+        let mut at = 0;
+        while at + 46 <= book.len() {
+            if book[at..at + 4] == 0x0201_4b50_u32.to_le_bytes() {
+                let name_len = usize::from(u16::from_le_bytes([book[at + 28], book[at + 29]]));
+                let name = String::from_utf8_lossy(&book[at + 46..at + 46 + name_len]).into_owned();
+                if names.contains(&name.as_str()) {
+                    book[at + 24..at + 28].copy_from_slice(&claimed.to_le_bytes());
+                }
+            }
+            at += 1;
+        }
+        book
+    }
+
+    #[test]
+    fn text_that_would_unpack_past_the_bound_is_refused_before_it_is_read() {
+        let book = claiming_to_unpack(
+            a_small_text_book(),
+            &["OEBPS/book.opf", "OEBPS/c0.xhtml"],
+            40 * 1024 * 1024,
+        );
+        let (result, reads) = drive(&book);
+        assert!(
+            matches!(result, Err(ShelfFault::TooLarge { bytes }) if bytes > 64 * 1024 * 1024),
+            "{result:?}"
+        );
+        let read: usize = reads.iter().map(|(_, length)| *length as usize).sum();
+        assert!(read <= book.len() + zip::MAX_TAIL, "{read}");
+    }
