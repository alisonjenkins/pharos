+    /// Hands every picture command to a cache the size of the runtime's,
+    /// failing on the first picture it has to evict to make room.
+    #[cfg(feature = "raster")]
+    fn replay(commands: Vec<Command>, cache: &mut kobo_ui::PictureCache) {
+        for command in commands {
+            match command {
+                Command::PutPicture {
+                    handle,
+                    width,
+                    height,
+                    format,
+                    pixels,
+                } => {
+                    let evicted = cache
+                        .put_report_with(handle, width, height, format, pixels)
+                        .expect("a picture the cache will take");
+                    assert!(
+                        evicted.is_empty(),
+                        "the view outgrew the runtime's cache, which threw out {evicted:?}"
+                    );
+                }
+                Command::DropPicture(handle) => cache.remove(handle),
+                _ => {}
+            }
+        }
+    }
+
+    /// [`drain`], with every command replayed into `cache`.
+    #[cfg(feature = "raster")]
+    fn drain_into(view: &mut BookView, cache: &mut kobo_ui::PictureCache) {
+        let mut passes = 0;
+        while let Some(task) = view.plating {
+            let mut context = Context::default();
+            let _ = view.woke(&mut context, task, &TaskOutcome::Completed(Vec::new()));
+            replay(context.take_commands(), cache);
+            passes += 1;
+            assert!(passes < 10_000, "the pipeline never came to rest");
+        }
+    }
