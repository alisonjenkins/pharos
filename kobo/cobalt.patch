+//! Downloads: a ranged stream kept on the reader's storage.
+//!
+//! A book from a ranged server is written block by block to a file the
+//! runtime owns, with a sidecar saying how long the file is and which blocks
+//! are present. The file is named by a hash of the URL without its `api_key`,
+//! so a new sign-in keeps the download. The sidecar is what lets a download
+//! survive a restart, a Wi-Fi drop or a power cut: a block counts only once
+//! it is on disk and the sidecar says so.
+//!
+//! The runtime, not the app, owns the files. An app's shelf is capped at a
+//! size far under an audiobook, and an app that could name a path could also
+//! name someone else's.
+
+use std::collections::{HashMap, HashSet};
+use std::fmt;
+use std::fs::{self, File, OpenOptions};
+use std::io::{self, Write};
+use std::os::unix::fs::{FileExt, MetadataExt};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex, MutexGuard, PoisonError};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+/// The most the downloads of all apps may add up to, counted by the full
+/// length of each book so a half-fetched one cannot overrun it later.
+pub const DEFAULT_BUDGET_BYTES: u64 = 4 * 1024 * 1024 * 1024;
+
+/// Free space on the volume below which nothing is started or continued.
+///
+/// The same card holds `KoboReader.sqlite`, the stock reader's whole library,
+/// and a database that cannot write comes back empty.
+pub const MIN_FREE_BYTES: u64 = 2 * 1024 * 1024 * 1024;
+
+/// Blocks written between saves of the sidecar. A power cut costs at most this
+/// many blocks of work, never a wrong block.
+const FLUSH_EVERY_BLOCKS: u32 = 16;
+
+const SIDECAR_MAGIC: &str = "pharos-download 2";
+const SIDECAR_SUFFIX: &str = "meta";
+const DATA_SUFFIX: &str = "dat";
+
+type FreeSpace = Arc<dyn Fn(&Path) -> Option<u64> + Send + Sync>;
+type Clock = Arc<dyn Fn() -> u64 + Send + Sync>;
+type LogLine = Arc<dyn Fn(&str) + Send + Sync>;
+
+/// How much a download may take, and how the volume and the clock are read.
+/// Injectable so a test can say the card is nearly full without filling one.
+#[derive(Clone)]
+pub struct DownloadPolicy {
+    /// The cap on all downloads together.
+    pub budget_bytes: u64,
+    /// Nothing is written while the volume has less free than this.
+    pub min_free_bytes: u64,
+    /// Free bytes on the volume holding a path; `None` when it cannot be asked,
+    /// which counts as room.
+    pub free_space: FreeSpace,
+    /// Seconds since the epoch, for ordering downloads by when they were
+    /// last played.
+    pub now: Clock,
+}
+
+impl Default for DownloadPolicy {
+    fn default() -> Self {
+        Self {
+            budget_bytes: DEFAULT_BUDGET_BYTES,
+            min_free_bytes: MIN_FREE_BYTES,
+            free_space: Arc::new(kobo_abi::free_space),
+            now: Arc::new(|| {
+                SystemTime::now()
+                    .duration_since(UNIX_EPOCH)
+                    .map_or(0, |since| since.as_secs())
+            }),
+        }
+    }
+}
+
+impl fmt::Debug for DownloadPolicy {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("DownloadPolicy")
+            .field("budget_bytes", &self.budget_bytes)
+            .field("min_free_bytes", &self.min_free_bytes)
+            .finish_non_exhaustive()
+    }
+}
+
+/// What downloads have done since the runtime started.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct DownloadStats {
+    pub started: u64,
+    pub resumed: u64,
+    pub completed: u64,
+    pub evicted: u64,
+    pub removed: u64,
+    /// Starts and writes refused because the volume was under the floor.
+    pub skipped_low_space: u64,
+    /// Starts refused because the budget had no room left to make.
+    pub skipped_budget: u64,
+    pub fetch_failures: u64,
+    pub blocks_written: u64,
+    pub bytes_written: u64,
+}
+
+#[derive(Default)]
+struct Counters {
+    started: AtomicU64,
+    resumed: AtomicU64,
+    completed: AtomicU64,
+    evicted: AtomicU64,
+    removed: AtomicU64,
+    skipped_low_space: AtomicU64,
+    skipped_budget: AtomicU64,
+    fetch_failures: AtomicU64,
+    blocks_written: AtomicU64,
+    bytes_written: AtomicU64,
+}
+
+fn bump(counter: &AtomicU64, by: u64) {
+    counter.fetch_add(by, Ordering::Relaxed);
+}
+
+/// How far one download has got.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct DownloadProgress {
+    pub url: String,
+    pub have: u64,
+    pub total: u64,
+}
+
+/// What removing a download did.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum RemoveOutcome {
+    Removed,
+    Absent,
+    /// A book playing from it is open.
+    InUse,
+}
+
+/// The downloads directory of the whole runtime: one folder per app.
+#[derive(Clone)]
+pub struct Downloads {
+    root: PathBuf,
+    policy: DownloadPolicy,
+    open: Arc<Mutex<OpenMap>>,
+    counters: Arc<Counters>,
+    log: LogLine,
+    /// Fails a named step of installing a download, for tests.
+    #[cfg(test)]
+    fault: Option<Fault>,
+}
+
+#[cfg(test)]
+type Fault = Arc<dyn Fn(&str) -> io::Result<()> + Send + Sync>;
+
+/// A download that some [`BlockStore`] has open.
+struct Open {
+    /// How many stores hold it.
+    count: usize,
+    /// What every store on the download shares, so a store that outlives its
+    /// book (the read-ahead worker is not joined) never saves an older state
+    /// over a newer one.
+    state: Arc<Mutex<Inner>>,
+    total: u64,
+    block_bytes: u32,
+}
+
+/// The open downloads by data file. Opening a download, removing one and
+/// evicting one all take this lock, so none can slip between another's check
+/// and act.
+type OpenMap = HashMap<PathBuf, Open>;
+
+impl fmt::Debug for Downloads {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Downloads")
+            .field("root", &self.root)
+            .field("policy", &self.policy)
+            .finish_non_exhaustive()
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+struct Meta {
+    total: u64,
+    block_bytes: u32,
+    played: u64,
+    complete: bool,
+    /// The data file this sidecar describes, by inode. A sidecar beside a
+    /// data file that is another one (a replacement that stopped between its
+    /// two renames) is not trusted.
+    file_id: u64,
+    present: Vec<u8>,
+}
+
+impl Meta {
+    fn fresh(total: u64, block_bytes: u32, played: u64) -> Self {
+        let blocks = blocks_of(total, block_bytes);
+        let bytes = usize::try_from(blocks.div_ceil(8)).unwrap_or(0);
+        Self {
+            total,
+            block_bytes,
+            played,
+            complete: false,
+            file_id: 0,
+            present: vec![0; bytes],
+        }
+    }
+
+    fn blocks(&self) -> u64 {
+        blocks_of(self.total, self.block_bytes)
+    }
+
+    fn has(&self, index: u64) -> bool {
+        if self.complete {
+            return index < self.blocks();
+        }
+        let byte = usize::try_from(index / 8).unwrap_or(usize::MAX);
+        self.present
+            .get(byte)
+            .is_some_and(|bits| bits & (1 << (index % 8)) != 0)
+    }
+
+    fn set(&mut self, index: u64) {
+        let byte = usize::try_from(index / 8).unwrap_or(usize::MAX);
+        if let Some(bits) = self.present.get_mut(byte) {
+            *bits |= 1 << (index % 8);
+        }
+    }
+
+    fn block_len(&self, index: u64) -> Option<u64> {
+        let start = index.checked_mul(u64::from(self.block_bytes))?;
+        if start >= self.total {
+            return None;
+        }
+        Some((self.total - start).min(u64::from(self.block_bytes)))
+    }
+
+    fn count(&self) -> u64 {
+        (0..self.blocks()).filter(|index| self.has(*index)).count() as u64
+    }
+
+    fn have_bytes(&self) -> u64 {
+        if self.complete {
+            return self.total;
+        }
+        (0..self.blocks())
+            .filter(|index| self.has(*index))
+            .filter_map(|index| self.block_len(index))
+            .sum()
+    }
+
+    fn all_present(&self) -> bool {
+        self.count() == self.blocks()
+    }
+
+    fn encode(&self) -> String {
+        let mut bits = String::with_capacity(self.present.len() * 2);
+        for byte in &self.present {
+            bits.push_str(&format!("{byte:02x}"));
+        }
+        format!(
+            "{SIDECAR_MAGIC}\ntotal={}\nblock={}\nplayed={}\ncomplete={}\nfile={}\nbits={bits}\n",
+            self.total,
+            self.block_bytes,
+            self.played,
+            u8::from(self.complete),
+            self.file_id,
+        )
+    }
+
+    fn decode(text: &str) -> Option<Self> {
+        let mut lines = text.lines();
+        if lines.next()? != SIDECAR_MAGIC {
+            return None;
+        }
+        let mut field = |name: &str| -> Option<String> {
+            let line = lines.next()?;
+            line.strip_prefix(name)?
+                .strip_prefix('=')
+                .map(str::to_owned)
+        };
+        let total: u64 = field("total")?.parse().ok()?;
+        let block_bytes: u32 = field("block")?.parse().ok()?;
+        let played: u64 = field("played")?.parse().ok()?;
+        let complete = match field("complete")?.as_str() {
+            "0" => false,
+            "1" => true,
+            _ => return None,
+        };
+        let file_id: u64 = field("file")?.parse().ok()?;
+        let bits = field("bits")?;
+        if block_bytes == 0 || total == 0 || bits.len() % 2 != 0 {
+            return None;
+        }
+        let present = (0..bits.len())
+            .step_by(2)
+            .map(|at| u8::from_str_radix(bits.get(at..at + 2)?, 16).ok())
+            .collect::<Option<Vec<u8>>>()?;
+        let meta = Self {
+            total,
+            block_bytes,
+            played,
+            complete,
+            file_id,
+            present,
+        };
+        let expected = usize::try_from(meta.blocks().div_ceil(8)).ok()?;
+        (meta.present.len() == expected).then_some(meta)
+    }
+}
+
+fn blocks_of(total: u64, block_bytes: u32) -> u64 {
+    total.div_ceil(u64::from(block_bytes.max(1)))
+}
+
+/// The URL as a download is keyed: the query without the credential.
+///
+/// A sign-in again gives the same book a new `api_key`, and it must find the
+/// download it already has.
+#[must_use]
+pub fn stable_url(url: &str) -> String {
+    let url = url.split('#').next().unwrap_or(url);
+    let Some((base, query)) = url.split_once('?') else {
+        return url.to_owned();
+    };
+    let kept: Vec<&str> = query
+        .split('&')
+        .filter(|pair| {
+            let name = pair.split('=').next().unwrap_or(pair);
+            !(name.eq_ignore_ascii_case("api_key") || name.eq_ignore_ascii_case("apikey"))
+        })
+        .collect();
+    if kept.is_empty() {
+        base.to_owned()
+    } else {
+        format!("{base}?{}", kept.join("&"))
+    }
+}
+
+/// A name for a download that does not change between builds: FNV-1a over
+/// 128 bits of [`stable_url`]. It names a file; nothing secret depends on it.
+#[must_use]
+pub fn key_of(url: &str) -> String {
+    const OFFSET: u128 = 0x6c62_2723_e07b_b014_62b8_2175_6295_c58d;
+    const PRIME: u128 = 0x0000_0000_0100_0000_0000_0000_0000_013b;
+    let hash = stable_url(url).bytes().fold(OFFSET, |hash, byte| {
+        (hash ^ u128::from(byte)).wrapping_mul(PRIME)
+    });
+    format!("{hash:032x}")
+}
+
+fn lock<T>(mutex: &Mutex<T>) -> MutexGuard<'_, T> {
+    mutex.lock().unwrap_or_else(PoisonError::into_inner)
+}
+
+/// An app's name as a folder: one path segment, nothing that climbs.
+fn valid_app(app: &str) -> bool {
+    !app.is_empty()
+        && app.len() <= 64
+        && app
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-' || byte == b'_')
+}
+
+struct Entry {
+    key: String,
+    data: PathBuf,
+    sidecar: PathBuf,
+    meta: Meta,
+}
+
+impl Downloads {
+    #[must_use]
+    pub fn new(root: PathBuf, policy: DownloadPolicy) -> Self {
+        Self {
+            root,
+            policy,
+            open: Arc::default(),
+            counters: Arc::default(),
+            log: Arc::new(|line| eprintln!("{line}")),
+            #[cfg(test)]
+            fault: None,
+        }
+    }
+
+    /// Sends log lines to `log` instead of standard error.
+    #[must_use]
+    pub fn with_log(mut self, log: impl Fn(&str) + Send + Sync + 'static) -> Self {
+        self.log = Arc::new(log);
+        self
+    }
+
+    #[must_use]
+    pub fn stats(&self) -> DownloadStats {
+        let c = &self.counters;
+        let get = |counter: &AtomicU64| counter.load(Ordering::Relaxed);
+        DownloadStats {
+            started: get(&c.started),
+            resumed: get(&c.resumed),
+            completed: get(&c.completed),
+            evicted: get(&c.evicted),
+            removed: get(&c.removed),
+            skipped_low_space: get(&c.skipped_low_space),
+            skipped_budget: get(&c.skipped_budget),
+            fetch_failures: get(&c.fetch_failures),
+            blocks_written: get(&c.blocks_written),
+            bytes_written: get(&c.bytes_written),
+        }
+    }
+
+    fn say(&self, line: &str) {
+        (self.log)(line);
+    }
+
+    fn paths(&self, app: &str, key: &str) -> (PathBuf, PathBuf) {
+        let dir = self.root.join(app);
+        (
+            dir.join(format!("{key}.{DATA_SUFFIX}")),
+            dir.join(format!("{key}.{SIDECAR_SUFFIX}")),
+        )
+    }
+
+    /// Whether `data` is the file `meta` was written for.
+    fn belongs(data: &Path, meta: &Meta) -> bool {
+        meta.file_id != 0 && fs::metadata(data).is_ok_and(|file| file.ino() == meta.file_id)
+    }
+
+    fn read_meta(sidecar: &Path) -> Option<Meta> {
+        Meta::decode(&fs::read_to_string(sidecar).ok()?)
+    }
+
+    fn write_meta(sidecar: &Path, meta: &Meta) -> io::Result<()> {
+        let staging = sidecar.with_extension("tmp");
+        Self::write_synced(&staging, &meta.encode())?;
+        fs::rename(&staging, sidecar)?;
+        Self::sync_dir(sidecar);
+        Ok(())
+    }
+
+    /// Writes `text` to `path` and has it on disk before returning, so a
+    /// rename of it never publishes a file whose contents can still be lost.
+    fn write_synced(path: &Path, text: &str) -> io::Result<()> {
+        let mut file = File::create(path)?;
+        file.write_all(text.as_bytes())?;
+        file.sync_all()
+    }
+
+    /// Has the rename that just put `published` in its folder reach the disk.
+    /// Best effort: a volume that cannot sync a folder is no worse off than
+    /// before.
+    fn sync_dir(published: &Path) {
+        if let Some(dir) = published.parent() {
+            let _ignored = File::open(dir).and_then(|dir| dir.sync_all());
+        }
+    }
+
+    /// Every download of every app.
+    fn scan(&self) -> Vec<Entry> {
+        let mut found = Vec::new();
+        let Ok(apps) = fs::read_dir(&self.root) else {
+            return found;
+        };
+        for app in apps.flatten() {
+            let Ok(files) = fs::read_dir(app.path()) else {
+                continue;
+            };
+            for file in files.flatten() {
+                let sidecar = file.path();
+                if sidecar.extension().and_then(|ext| ext.to_str()) != Some(SIDECAR_SUFFIX) {
+                    continue;
+                }
+                let Some(key) = sidecar.file_stem().and_then(|stem| stem.to_str()) else {
+                    continue;
+                };
+                let Some(meta) = Self::read_meta(&sidecar) else {
+                    continue;
+                };
+                found.push(Entry {
+                    key: key.to_owned(),
+                    data: sidecar.with_extension(DATA_SUFFIX),
+                    sidecar: sidecar.clone(),
+                    meta,
+                });
+            }
+        }
+        found
+    }
+
+    fn is_open(open: &OpenMap, data: &Path) -> bool {
+        open.get(data).is_some_and(|entry| entry.count > 0)
+    }
+
+    fn delete(entry: &Entry) {
+        let _ignored = fs::remove_file(&entry.data);
+        let _ignored = fs::remove_file(&entry.sidecar);
+    }
+
+    /// Frees the least recently played complete downloads that nothing has
+    /// open until `needed` more bytes fit in the budget. `false` when they
+    /// do not fit even then.
+    fn make_room(&self, open: &OpenMap, needed: u64, keep: &Path) -> bool {
+        let budget = self.policy.budget_bytes;
+        if needed > budget {
+            return false;
+        }
+        let mut entries = self.scan();
+        // A sidecar beside a file that is not its own is junk that eviction
+        // would never take (it is not complete): reclaim it so it does not
+        // hold the budget against another book.
+        entries.retain(|entry| {
+            let junk = !Self::belongs(&entry.data, &entry.meta)
+                && entry.data != keep
+                && !Self::is_open(open, &entry.data);
+            if junk {
+                Self::delete(entry);
+                self.say(&format!(
+                    "downloads: reclaim key={} reason=sidecar and data file are not a pair",
+                    entry.key
+                ));
+            }
+            !junk
+        });
+        let mut used: u64 = entries
+            .iter()
+            .filter(|entry| entry.data != keep)
+            .map(|entry| entry.meta.total)
+            .sum();
+        if used.saturating_add(needed) <= budget {
+            return true;
+        }
+        entries.retain(|entry| entry.meta.complete && entry.data != keep);
+        entries.sort_by_key(|entry| entry.meta.played);
+        for entry in entries {
+            if used.saturating_add(needed) <= budget {
+                break;
+            }
+            if Self::is_open(open, &entry.data) {
+                continue;
+            }
+            Self::delete(&entry);
+            used = used.saturating_sub(entry.meta.total);
+            bump(&self.counters.evicted, 1);
+            self.say(&format!(
+                "downloads: evict key={} bytes={} played={} reason=over budget {budget} to fit {needed}",
+                entry.key, entry.meta.total, entry.meta.played
+            ));
+        }
+        used.saturating_add(needed) <= budget
+    }
+
+    /// The download of `url` for `app`, ready to be written and read; `None`
+    /// when the book is not to be kept on disk.
+    ///
+    /// `expected_total` is the length the server reported. `None` means the
+    /// network could not be asked, and an existing download is then used as
+    /// it stands. A download of another length or block size is a different
+    /// file and is replaced.
+    #[must_use]
+    pub fn begin(
+        &self,
+        app: &str,
+        url: &str,
+        expected_total: Option<u64>,
+        block_bytes: u32,
+    ) -> Option<BlockStore> {
+        if !valid_app(app) || block_bytes == 0 {
+            self.say(&format!(
+                "downloads: skip app={app:?} reason=unusable app name or block size {block_bytes}"
+            ));
+            return None;
+        }
+        let key = key_of(url);
+        let (data, sidecar) = self.paths(app, &key);
+        let mut open = lock(&self.open);
+        let now = (self.policy.now)();
+        let fits = |total: u64, block: u32| {
+            expected_total.is_none_or(|expected| expected == total)
+                && (expected_total.is_none() || block == block_bytes)
+                && data.is_file()
+        };
+        // A download already open is the state of record, not the sidecar,
+        // which may be behind it.
+        let shared = open
+            .get(&data)
+            .filter(|entry| fits(entry.total, entry.block_bytes))
+            .map(|entry| Arc::clone(&entry.state));
+        let mut from_disk = if shared.is_none() {
+            let existing = Self::read_meta(&sidecar).filter(|meta| {
+                let same = fits(meta.total, meta.block_bytes);
+                if same && !Self::belongs(&data, meta) {
+                    self.say(&format!(
+                        "downloads: discard key={key} reason=sidecar and data file are not a pair"
+                    ));
+                    return false;
+                }
+                if !same {
+                    self.say(&format!(
+                        "downloads: replace key={key} had_bytes={} server_bytes={expected_total:?} reason=length or block size changed",
+                        meta.total
+                    ));
+                }
+                same
+            });
+            let (mut meta, fresh) = match existing {
+                Some(meta) => (meta, false),
+                None => (
+                    self.create(&open, app, &key, expected_total, block_bytes)?,
+                    true,
+                ),
+            };
+            meta.played = now;
+            Some((meta, fresh))
+        } else {
+            None
+        };
+        let file = self.open_file(&key, &data, &sidecar, &mut from_disk)?;
+        let fresh = from_disk.as_ref().is_some_and(|(_, fresh)| *fresh);
+        // The open lock comes after a store's own lock everywhere, so no
+        // store's state is locked while it is held.
+        let (total, block) = match (&shared, &from_disk) {
+            (Some(_), _) => open
+                .get(&data)
+                .map(|entry| (entry.total, entry.block_bytes))?,
+            (None, Some((meta, _))) => (meta.total, meta.block_bytes),
+            (None, None) => return None,
+        };
+        let state = match (shared, from_disk) {
+            (Some(state), _) => state,
+            (None, Some((meta, _))) => Arc::new(Mutex::new(Inner {
+                meta,
+                unflushed: 0,
+                low_space_noted: false,
+            })),
+            (None, None) => return None,
+        };
+        let entry = open.entry(data.clone()).or_insert_with(|| Open {
+            count: 0,
+            state: Arc::clone(&state),
+            total,
+            block_bytes: block,
+        });
+        entry.count += 1;
+        entry.state = Arc::clone(&state);
+        entry.total = total;
+        entry.block_bytes = block;
+        drop(open);
+        let have = {
+            let mut inner = lock(&state);
+            inner.meta.played = now;
+            inner.meta.have_bytes()
+        };
+        self.announce(&key, app, fresh, have, total);
+        Some(BlockStore {
+            file,
+            data,
+            sidecar,
+            key,
+            inner: state,
+            downloads: self.clone(),
+        })
+    }
+
+    /// The data file, sized and with its sidecar written when `made` holds a
+    /// new or resumed download's metadata; as it stands when the download is
+    /// already open.
+    fn open_file(
+        &self,
+        key: &str,
+        data: &Path,
+        sidecar: &Path,
+        made: &mut Option<(Meta, bool)>,
+    ) -> Option<File> {
+        match made {
+            Some((meta, true)) => self.install(data, sidecar, meta),
+            Some((meta, false)) => Self::open_data(data)
+                .and_then(|file| Self::write_meta(sidecar, meta).map(|()| file)),
+            None => Self::open_data(data),
+        }
+        .map_err(|error| {
+            self.say(&format!(
+                "downloads: skip key={key} path={} reason=cannot create: {error}",
+                data.display()
+            ));
+        })
+        .ok()
+    }
+
+    #[cfg_attr(not(test), allow(clippy::unused_self, clippy::unnecessary_wraps))]
+    fn step(&self, name: &str) -> io::Result<()> {
+        #[cfg(test)]
+        if let Some(fault) = &self.fault {
+            return fault(name);
+        }
+        let _ = name;
+        Ok(())
+    }
+
+    #[cfg(test)]
+    pub(crate) fn with_fault(
+        mut self,
+        fault: impl Fn(&str) -> io::Result<()> + Send + Sync + 'static,
+    ) -> Self {
+        self.fault = Some(Arc::new(fault));
+        self
+    }
+
+    fn open_data(data: &Path) -> io::Result<File> {
+        OpenOptions::new()
+            .create(true)
+            .truncate(false)
+            .read(true)
+            .write(true)
+            .open(data)
+    }
+
+    /// Puts a new download in place of whatever is at `data` and `sidecar`.
+    /// Both are prepared under other names and renamed over the old pair, so
+    /// a failure before that leaves the old download as it was.
+    fn install(&self, data: &Path, sidecar: &Path, meta: &mut Meta) -> io::Result<File> {
+        let staged_data = data.with_extension("new");
+        let staged_sidecar = sidecar.with_extension("tmp");
+        let cleanup = || {
+            let _ignored = fs::remove_file(&staged_data);
+            let _ignored = fs::remove_file(&staged_sidecar);
+        };
+        let prepared = OpenOptions::new()
+            .create(true)
+            .truncate(true)
+            .read(true)
+            .write(true)
+            .open(&staged_data)
+            .and_then(|file| file.set_len(meta.total).map(|()| file))
+            .and_then(|file| file.sync_all().map(|()| file))
+            .and_then(|file| {
+                meta.file_id = file.metadata()?.ino();
+                Self::write_synced(&staged_sidecar, &meta.encode()).map(|()| file)
+            })
+            .and_then(|file| self.step("rename-data").map(|()| file));
+        let file = match prepared {
+            Ok(file) => file,
+            Err(error) => {
+                cleanup();
+                return Err(error);
+            }
+        };
+        if let Err(error) = fs::rename(&staged_data, data) {
+            cleanup();
+            return Err(error);
+        }
+        // The sidecar names the new data file's inode, so it is the commit:
+        // before it lands the old sidecar names a file that is gone and the
+        // pair is discarded on the next open, never trusted.
+        let committed = self
+            .step("rename-sidecar")
+            .and_then(|()| fs::rename(&staged_sidecar, sidecar));
+        if let Err(error) = committed {
+            cleanup();
+            let _ignored = fs::remove_file(data);
+            let _ignored = fs::remove_file(sidecar);
+            return Err(error);
+        }
+        Self::sync_dir(sidecar);
+        Ok(file)
+    }
+
+    fn announce(&self, key: &str, app: &str, fresh: bool, have: u64, total: u64) {
+        if fresh {
+            bump(&self.counters.started, 1);
+            self.say(&format!(
+                "downloads: start key={key} app={app} bytes={total}"
+            ));
+        } else {
+            bump(&self.counters.resumed, 1);
+            self.say(&format!(
+                "downloads: resume key={key} app={app} have={have} bytes={total}"
+            ));
+        }
+    }
+
+    /// Clears what is on disk for `key` and admits a new download of
+    /// `expected_total` bytes in its place: its first metadata.
+    fn create(
+        &self,
+        open: &OpenMap,
+        app: &str,
+        key: &str,
+        expected_total: Option<u64>,
+        block_bytes: u32,
+    ) -> Option<Meta> {
+        let dir = self.root.join(app);
+        let (data, sidecar) = self.paths(app, key);
+        fs::create_dir_all(&dir)
+            .map_err(|error| {
+                self.say(&format!(
+                    "downloads: skip key={key} dir={} reason=cannot create: {error}",
+                    dir.display()
+                ));
+            })
+            .ok()?;
+        let clear = || {
+            let _ignored = fs::remove_file(&data);
+            let _ignored = fs::remove_file(&sidecar);
+        };
+        let Some(total) = expected_total.filter(|total| *total > 0) else {
+            clear();
+            return None;
+        };
+        // Nothing on disk is touched yet: a store still open on it saves its
+        // sidecar again, which must find its data file. `install` swaps the
+        // files only once the new pair is ready.
+        self.admit(open, key, &dir, &data, total)?;
+        Some(Meta::fresh(total, block_bytes, 0))
+    }
+
+    /// Whether a new download of `total` bytes may start: the volume has room
+    /// above the floor and the budget has room after evicting.
+    fn admit(&self, open: &OpenMap, key: &str, dir: &Path, data: &Path, total: u64) -> Option<()> {
+        let free = (self.policy.free_space)(dir);
+        if free.is_some_and(|free| free < self.policy.min_free_bytes) {
+            bump(&self.counters.skipped_low_space, 1);
+            self.say(&format!(
+                "downloads: skip key={key} bytes={total} reason=low space free={free:?} floor={}",
+                self.policy.min_free_bytes
+            ));
+            return None;
+        }
+        if !self.make_room(open, total, data) {
+            bump(&self.counters.skipped_budget, 1);
+            self.say(&format!(
+                "downloads: skip key={key} bytes={total} reason=over budget {}",
+                self.policy.budget_bytes
+            ));
+            return None;
+        }
+        Some(())
+    }
+
+    /// How far each of `urls` has got, leaving out any with no download.
+    #[must_use]
+    pub fn progress(&self, app: &str, urls: &[String]) -> Vec<DownloadProgress> {
+        if !valid_app(app) {
+            return Vec::new();
+        }
+        let mut seen = HashSet::new();
+        urls.iter()
+            .filter_map(|url| {
+                let (data, sidecar) = self.paths(app, &key_of(url));
+                let meta = Self::read_meta(&sidecar).filter(|meta| Self::belongs(&data, meta))?;
+                seen.insert(sidecar).then(|| DownloadProgress {
+                    url: url.clone(),
+                    have: meta.have_bytes(),
+                    total: meta.total,
+                })
+            })
+            .collect()
+    }
+
+    /// Deletes the download of `url`, unless a book is playing from it.
+    #[must_use]
+    pub fn remove(&self, app: &str, url: &str) -> RemoveOutcome {
+        if !valid_app(app) {
+            return RemoveOutcome::Absent;
+        }
+        let key = key_of(url);
+        let (data, sidecar) = self.paths(app, &key);
+        let open = lock(&self.open);
+        if Self::is_open(&open, &data) {
+            self.say(&format!("downloads: remove refused key={key} reason=open"));
+            return RemoveOutcome::InUse;
+        }
+        let Some(meta) = Self::read_meta(&sidecar) else {
+            return RemoveOutcome::Absent;
+        };
+        Self::delete(&Entry {
+            key: key.clone(),
+            data,
+            sidecar,
+            meta: meta.clone(),
+        });
+        bump(&self.counters.removed, 1);
+        self.say(&format!(
+            "downloads: remove key={key} bytes={} have={}",
+            meta.total,
+            meta.have_bytes()
+        ));
+        RemoveOutcome::Removed
+    }
+}
+
+struct Inner {
+    meta: Meta,
+    unflushed: u32,
+    low_space_noted: bool,
+}
+
+/// One download, open: its blocks on disk and which of them are there.
+/// Dropping it saves the sidecar and lets the download be evicted again.
+pub struct BlockStore {
+    file: File,
+    data: PathBuf,
+    sidecar: PathBuf,
+    key: String,
+    inner: Arc<Mutex<Inner>>,
+    downloads: Downloads,
+}
+
+impl fmt::Debug for BlockStore {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("BlockStore")
+            .field("key", &self.key)
+            .finish_non_exhaustive()
+    }
+}
+
+impl BlockStore {
+    fn inner(&self) -> MutexGuard<'_, Inner> {
+        lock(&self.inner)
+    }
+
+    #[must_use]
+    pub fn total(&self) -> u64 {
+        self.inner().meta.total
+    }
+
+    #[must_use]
+    pub fn block_bytes(&self) -> u32 {
+        self.inner().meta.block_bytes
+    }
+
+    #[must_use]
+    pub fn has(&self, index: u64) -> bool {
+        self.inner().meta.has(index)
+    }
+
+    #[must_use]
+    pub fn is_complete(&self) -> bool {
+        self.inner().meta.complete
+    }
+
+    #[must_use]
+    pub fn have_bytes(&self) -> u64 {
+        self.inner().meta.have_bytes()
+    }
+
+    /// The first block at or after `start` that is not on disk, wrapping to
+    /// the start of the file; `None` when every block is.
+    #[must_use]
+    pub fn missing_from(&self, start: u64) -> Option<u64> {
+        let inner = self.inner();
+        if inner.meta.complete {
+            return None;
+        }
+        let blocks = inner.meta.blocks();
+        let start = if start >= blocks { 0 } else { start };
+        (start..blocks)
+            .chain(0..start)
+            .find(|index| !inner.meta.has(*index))
+    }
+
+    /// Reads block `index` from disk.
+    ///
+    /// # Errors
+    /// The block is not on disk, or the file could not be read.
+    pub fn read(&self, index: u64) -> io::Result<Vec<u8>> {
+        let (len, at) = {
+            let inner = self.inner();
+            if !inner.meta.has(index) {
+                return Err(io::Error::new(
+                    io::ErrorKind::NotFound,
+                    "block not downloaded",
+                ));
+            }
+            let len = inner
+                .meta
+                .block_len(index)
+                .ok_or_else(|| io::Error::from(io::ErrorKind::InvalidInput))?;
+            (len, index * u64::from(inner.meta.block_bytes))
+        };
+        let mut bytes = vec![0; usize::try_from(len).map_err(|_| io::ErrorKind::InvalidInput)?];
+        self.file.read_exact_at(&mut bytes, at)?;
+        Ok(bytes)
+    }
+
+    /// Writes block `index` and marks it present. `false` when the volume is
+    /// under the free-space floor and the block was left unwritten.
+    ///
+    /// # Errors
+    /// The length is not the block's, or the file could not be written.
+    pub fn write(&self, index: u64, bytes: &[u8]) -> io::Result<bool> {
+        let (expected, at) = {
+            let inner = self.inner();
+            if inner.meta.has(index) {
+                return Ok(true);
+            }
+            (
+                inner.meta.block_len(index),
+                index.saturating_mul(u64::from(inner.meta.block_bytes)),
+            )
+        };
+        if expected != u64::try_from(bytes.len()).ok() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                format!(
+                    "block {index} is {} bytes, expected {expected:?}",
+                    bytes.len()
+                ),
+            ));
+        }
+        if !self.room_to_write() {
+            return Ok(false);
+        }
+        self.file.write_all_at(bytes, at)?;
+        let counters = &self.downloads.counters;
+        bump(&counters.blocks_written, 1);
+        bump(&counters.bytes_written, bytes.len() as u64);
+        let mut inner = self.inner();
+        inner.meta.set(index);
+        inner.unflushed += 1;
+        if inner.meta.all_present() {
+            drop(inner);
+            self.finish()?;
+        } else if inner.unflushed >= FLUSH_EVERY_BLOCKS {
+            drop(inner);
+            self.flush()?;
+        }
+        Ok(true)
+    }
+
+    /// Whether the volume has room for another block above the floor.
+    #[must_use]
+    pub fn has_room(&self) -> bool {
+        self.room_to_write()
+    }
+
+    /// Logs a block that could not be written to disk, with the cause.
+    pub fn note_write_failure(&self, index: u64, error: &io::Error) {
+        self.downloads.say(&format!(
+            "downloads: write failed key={} block={index} reason={error}",
+            self.key
+        ));
+    }
+
+    fn room_to_write(&self) -> bool {
+        let policy = &self.downloads.policy;
+        let dir = self.data.parent().unwrap_or(&self.data);
+        let free = (policy.free_space)(dir);
+        let low = free.is_some_and(|free| free < policy.min_free_bytes);
+        let mut inner = self.inner();
+        if low && !inner.low_space_noted {
+            bump(&self.downloads.counters.skipped_low_space, 1);
+            self.downloads.say(&format!(
+                "downloads: pause key={} have={} reason=low space free={free:?} floor={}",
+                self.key,
+                inner.meta.have_bytes(),
+                policy.min_free_bytes
+            ));
+        }
+        inner.low_space_noted = low;
+        !low
+    }
+
+    /// Saves the sidecar, after the blocks it names have reached the disk.
+    ///
+    /// # Errors
+    /// The file or the sidecar could not be written.
+    pub fn flush(&self) -> io::Result<()> {
+        // The lock comes first: a block marked present while the sync runs
+        // would be saved as there with its data possibly not on disk.
+        let mut inner = self.inner();
+        self.file.sync_data()?;
+        inner.unflushed = 0;
+        self.save(&inner)
+    }
+
+    /// Writes the sidecar, unless a newer open of the download has replaced
+    /// this one's state: a store left over from a replaced book must not put
+    /// its older sidecar over the new book's. Held under the open lock so a
+    /// replacement cannot land between the check and the write.
+    fn save(&self, inner: &Inner) -> io::Result<()> {
+        let open = lock(&self.downloads.open);
+        let current = open
+            .get(&self.data)
+            .is_some_and(|entry| Arc::ptr_eq(&entry.state, &self.inner));
+        if !current {
+            return Ok(());
+        }
+        Downloads::write_meta(&self.sidecar, &inner.meta)
+    }
+
+    /// Every block is present: checks the file is the length the server
+    /// said and marks the download complete.
+    fn finish(&self) -> io::Result<()> {
+        let length = self.file.metadata()?.len();
+        let total = self.total();
+        if length != total {
+            let mut inner = self.inner();
+            inner.meta.present.fill(0);
+            let _saved = self.save(&inner);
+            self.downloads.say(&format!(
+                "downloads: verify failed key={} file_bytes={length} server_bytes={total}; refetching",
+                self.key
+            ));
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                format!("download is {length} bytes, expected {total}"),
+            ));
+        }
+        self.inner().meta.complete = true;
+        self.flush()?;
+        bump(&self.downloads.counters.completed, 1);
+        self.downloads.say(&format!(
+            "downloads: complete key={} bytes={total}",
+            self.key
+        ));
+        Ok(())
+    }
+
+    /// Counts and logs a failed fetch of the block at `offset`. `gave_up` is
+    /// the last attempt at it, and the only one logged.
+    pub fn note_fetch_failure(&self, offset: u64, why: &str, gave_up: bool) {
+        bump(&self.downloads.counters.fetch_failures, 1);
+        if gave_up {
+            self.downloads.say(&format!(
+                "downloads: fetch failed key={} offset={offset} have={} reason={why}",
+                self.key,
+                self.have_bytes()
+            ));
+        }
+    }
+}
+
+impl Drop for BlockStore {
+    fn drop(&mut self) {
+        let _saved = self.flush();
+        let mut open = lock(&self.downloads.open);
+        if let Some(entry) = open.get_mut(&self.data) {
+            entry.count = entry.count.saturating_sub(1);
+            if entry.count == 0 {
+                open.remove(&self.data);
+            }
+        }
+    }
+}
