+    /// How many plates the large book carries, and how large each is.
+    pub(crate) const PLATES: usize = 24;
+    const PLATE_BYTES: usize = 1024 * 1024;
+
+    /// A book of [`PLATES`] chapters, each with a megabyte plate, and one
+    /// more picture whose bytes are not a picture at all.
+    pub(crate) fn a_large_illustrated_book() -> Vec<u8> {
+        let mut manifest = String::new();
+        let mut spine = String::new();
+        let mut members = Vec::new();
+        for index in 0..=PLATES {
+            manifest.push_str(&format!(
+                r#"<item id="c{index}" href="c{index}.xhtml" media-type="application/xhtml+xml"/>
+                   <item id="p{index}" href="p/{index}.png" media-type="image/png"/>"#
+            ));
+            spine.push_str(&format!(r#"<itemref idref="c{index}"/>"#));
+            members.push((
+                format!("OEBPS/c{index}.xhtml"),
+                format!(
+                    "<html><body><h1>Plate {index}</h1><p>Words about it.</p>\
+                     <img src=\"p/{index}.png\" alt=\"plate {index}\"/></body></html>"
+                )
+                .into_bytes(),
+            ));
+            let mut plate = if index == PLATES {
+                vec![7; MEASURE * 2]
+            } else {
+                let width = u32::try_from(100 + index).expect("a width");
+                kobo_image::encode_png_grey(width, 300, &vec![128; width as usize * 300])
+                    .expect("a png")
+            };
+            // Bytes after the end of a PNG are ignored by any decoder, and
+            // make the plate as large as a scan is.
+            plate.resize(PLATE_BYTES.max(plate.len()), 0);
+            members.push((format!("OEBPS/p/{index}.png"), plate));
+        }
+        let package = format!(
+            r#"<?xml version="1.0"?>
+<package xmlns="http://www.idpf.org/2007/opf" version="3.0">
+  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/"><dc:title>Plates</dc:title></metadata>
+  <manifest>{manifest}</manifest>
+  <spine>{spine}</spine>
+</package>"#
+        );
+        let mut book = vec![
+            ("mimetype".to_owned(), b"application/epub+zip".to_vec()),
+            (
+                "META-INF/container.xml".to_owned(),
+                br#"<?xml version="1.0"?>
