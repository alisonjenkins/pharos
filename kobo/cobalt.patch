+  <rootfiles><rootfile full-path="OEBPS/book.opf" media-type="application/oebps-package+xml"/></rootfiles>
+</container>"#
+                    .to_vec(),
+            ),
+            ("OEBPS/book.opf".to_owned(), package.into_bytes()),
+        ];
+        book.append(&mut members);
+        zip::stored(&book).expect("a book")
+    }
