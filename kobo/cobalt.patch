+    /// Drives an opening against `book` as the shelf would answer it,
+    /// returning what came of it and every read asked for.
+    pub(crate) fn drive(book: &[u8]) -> (Result<Next, ShelfFault>, Vec<(u32, u32)>) {
+        let (mut opening, mut read) = Opening::start();
+        let mut reads = vec![read];
+        let size = u32::try_from(book.len()).expect("a test book");
+        loop {
+            let (offset, length) = read;
+            let from = offset as usize;
+            let to = (from + length as usize).min(book.len());
+            match opening.answer(offset, &book[from..to], size) {
+                Ok(Next::Read(offset, length)) => {
+                    read = (offset, length);
+                    reads.push(read);
+                }
+                done => return (done, reads),
+            }
+        }
+    }
