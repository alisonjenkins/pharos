+    /// Hands every picture command to a cache the size of the runtime's,
+    /// failing on the first picture it has to evict to make room.
+    #[cfg(feature = "raster")]
+    fn replay(commands: Vec<Command>, cache: &mut kobo_ui::PictureCache) {
+        for command in commands {
+            match command {
+                Command::PutPicture {
+                    handle,
+                    width,
+                    height,
+                    format,
+                    pixels,
+                } => {
+                    let evicted = cache
+                        .put_report_with(handle, width, height, format, pixels)
+                        .expect("a picture the cache will take");
