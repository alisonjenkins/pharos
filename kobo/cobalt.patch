+    assert!(old.write(0, &block(0, 3_000)).unwrap());
+    old.flush().unwrap();
+    let failing = plain.clone().with_fault(|step| {
+        if step == "rename-sidecar" {
+            Err(std::io::Error::other("injected"))
+        } else {
+            Ok(())
+        }
+    });
+    assert!(failing.begin("shelf", URL, Some(4_000), BLOCK).is_none());
+    // The old store goes on to save its sidecar, as it would.
+    drop(old);
+    assert!(
+        plain.progress("shelf", &[URL.to_owned()]).is_empty(),
+        "an old sidecar is listed beside new data"
+    );
+    assert!(plain.begin("shelf", URL, None, BLOCK).is_none());
