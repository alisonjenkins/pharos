+    /// A book of `count` plates, a page or so of prose before each.
+    #[cfg(feature = "raster")]
+    fn plates(count: usize, plate: &[u8]) -> Document {
+        let mut blocks = Vec::new();
+        let mut images = BTreeMap::new();
+        for index in 0..count {
+            blocks.extend(prose(12));
+            let name = format!("plate-{index}.png");
+            images.insert(name.clone(), plate.to_vec());
+            blocks.push(Block::Picture {
+                name,
+                alt: "Four rabbits".to_owned(),
+                illustration: true,
+            });
+        }
+        Document {
+            blocks,
+            images,
+            ..Document::default()
+        }
+    }
