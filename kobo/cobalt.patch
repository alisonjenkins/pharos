+
+/// A server that honours ranges over `bytes`, logging every offset asked.
+pub(crate) fn served(bytes: Arc<Vec<u8>>, log: Arc<Mutex<Vec<u64>>>) -> RangeFetch {
+    Arc::new(move |offset, len| {
+        log.lock().unwrap().push(offset);
+        let start = usize::try_from(offset).unwrap();
+        let end = (start + len as usize).min(bytes.len());
+        Ok(bytes.get(start..end).unwrap_or_default().to_vec())
+    })
+}
+
+/// Small blocks and no patience, so a test sees many blocks and no waits.
+pub(crate) fn quick(block_bytes: u32) -> RemoteOptions {
+    RemoteOptions {
+        block_bytes,
+        resident_blocks: 8,
+        ahead_blocks: 4,
+        behind_blocks: 1,
+        retry_delays: vec![Duration::from_millis(1)],
+        give_up_after: Duration::from_millis(200),
+    }
+}
+
+fn pattern(len: usize) -> Arc<Vec<u8>> {
+    #[allow(clippy::cast_possible_truncation, reason = "a repeating byte pattern")]
+    Arc::new((0..len).map(|at| (at % 251) as u8).collect())
+}
+
+fn eventually(what: &str, done: impl Fn() -> bool) {
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while !done() {
+        assert!(Instant::now() < deadline, "never: {what}");
+        std::thread::sleep(Duration::from_millis(5));
+    }
+}
+
+#[test]
+fn the_end_can_be_read_before_the_start() {
+    // An M4B with its index at the end is probed exactly like this.
+    let bytes = pattern(40_000);
+    let log = Arc::new(Mutex::new(Vec::new()));
+    let remote = Remote::open(
+        served(Arc::clone(&bytes), Arc::clone(&log)),
+        40_000,
+        Vec::new(),
+        quick(4_096),
+    )
+    .unwrap();
+    let mut reader = remote.reader();
+    reader.seek(SeekFrom::End(-100)).unwrap();
+    let mut tail = vec![0; 100];
+    reader.read_exact(&mut tail).unwrap();
+    assert_eq!(tail, bytes[39_900..]);
+    assert_eq!(
+        log.lock().unwrap().first(),
+        Some(&(9 * 4_096)),
+        "asked the end first"
+    );
+
+    reader.seek(SeekFrom::Start(0)).unwrap();
+    let mut head = vec![0; 5_000];
+    reader.read_exact(&mut head).unwrap();
+    assert_eq!(head, bytes[..5_000]);
+    let mut rest = Vec::new();
+    reader.read_to_end(&mut rest).unwrap();
+    assert_eq!(rest, bytes[5_000..]);
+}
+
+#[test]
+fn several_readers_share_one_cache_each_at_its_own_place() {
+    let bytes = pattern(20_000);
+    let log = Arc::new(Mutex::new(Vec::new()));
+    let remote = Remote::open(
+        served(Arc::clone(&bytes), Arc::clone(&log)),
+        20_000,
+        Vec::new(),
+        quick(4_096),
+    )
+    .unwrap();
+    let mut first = remote.reader();
+    let mut second = remote.reader();
+    let mut a = vec![0; 3_000];
+    let mut b = vec![0; 3_000];
+    first.read_exact(&mut a).unwrap();
+    second.read_exact(&mut b).unwrap();
+    assert_eq!(a, b);
+    assert_eq!(a, bytes[..3_000]);
+    let block_zero = log
+        .lock()
+        .unwrap()
+        .iter()
+        .filter(|offset| **offset == 0)
+        .count();
+    assert_eq!(block_zero, 1, "the second reader fetched block 0 again");
+}
+
+#[test]
+fn a_seeded_first_block_is_not_fetched_again() {
+    let bytes = pattern(10_000);
+    let log = Arc::new(Mutex::new(Vec::new()));
+    let remote = Remote::open(
+        served(Arc::clone(&bytes), Arc::clone(&log)),
+        10_000,
+        bytes[..4_096].to_vec(),
+        quick(4_096),
+    )
+    .unwrap();
+    let mut all = Vec::new();
+    remote.reader().read_to_end(&mut all).unwrap();
+    assert_eq!(all, *bytes);
+    assert!(
+        !log.lock().unwrap().contains(&0),
+        "{:?}",
+        log.lock().unwrap()
+    );
+}
+
+#[test]
+fn the_blocks_after_the_read_position_are_fetched_without_being_read() {
+    let bytes = pattern(100 * 1_024);
+    let log = Arc::new(Mutex::new(Vec::new()));
+    let remote = Remote::open(
+        served(bytes, Arc::clone(&log)),
+        100 * 1_024,
+        Vec::new(),
+        quick(1_024),
+    )
+    .unwrap();
+    let mut one = [0; 1];
+    remote.reader().read_exact(&mut one).unwrap();
+    // Block 0 plus the four ahead of it, and no further.
+    eventually("read-ahead filled its window", || {
+        log.lock().unwrap().len() >= 5
+    });
+    std::thread::sleep(Duration::from_millis(50));
+    let mut asked = log.lock().unwrap().clone();
+    asked.sort_unstable();
+    assert_eq!(asked, vec![0, 1_024, 2_048, 3_072, 4_096]);
+}
+
+#[test]
+fn three_hundred_megabytes_read_in_order_never_hold_more_than_eight_mebibytes() {
+    const TOTAL: u64 = 300 * 1_000 * 1_000;
+    // Every byte of a block is its block number, so no 300 MB buffer exists.
+    let fetch: RangeFetch = Arc::new(|offset, len| {
+        #[allow(clippy::cast_possible_truncation, reason = "a marker byte")]
+        let marker = (offset / (256 * 1_024)) as u8;
+        let len = u64::from(len).min(TOTAL - offset);
+        Ok(vec![marker; usize::try_from(len).unwrap()])
+    });
+    let options = RemoteOptions::default();
+    let remote = Remote::open(fetch, TOTAL, Vec::new(), options).unwrap();
+    let mut reader = remote.reader();
+    let mut buffer = vec![0; 64 * 1_024];
+    let mut read_total = 0_u64;
+    loop {
+        let read = reader.read(&mut buffer).unwrap();
+        if read == 0 {
+            break;
+        }
+        #[allow(clippy::cast_possible_truncation, reason = "a marker byte")]
+        let marker = (read_total / (256 * 1_024)) as u8;
+        assert_eq!(buffer[0], marker, "at {read_total}");
+        read_total += read as u64;
+    }
+    assert_eq!(read_total, TOTAL);
+    let stats = remote.stats();
+    assert!(
+        stats.peak_resident_bytes <= 8 * 1_024 * 1_024,
+        "held {} bytes at once",
+        stats.peak_resident_bytes
+    );
+    assert!(stats.evictions > 1_000, "{stats:?}");
+}
+
+#[test]
+fn the_read_ahead_thread_returns_once_the_remote_is_dropped() {
+    let bytes = pattern(50_000);
+    let remote = Remote::open(
+        served(bytes, Arc::new(Mutex::new(Vec::new()))),
+        50_000,
+        Vec::new(),
+        quick(1_024),
+    )
+    .unwrap();
+    let mut one = [0; 1];
+    remote.reader().read_exact(&mut one).unwrap();
+    let exited = remote.exit_flag();
+    assert!(
+        !exited(),
+        "the thread stopped before the remote was dropped"
+    );
+    drop(remote);
+    eventually("the read-ahead thread exits", || exited());
+}
+
+#[test]
+fn a_dropped_remote_ends_a_retry_wait_at_once() {
+    let fetch: RangeFetch = Arc::new(|_, _| Err(FetchFailure::Transient));
+    let options = RemoteOptions {
+        retry_delays: vec![Duration::from_secs(60)],
+        give_up_after: Duration::from_secs(600),
+        ..quick(1_024)
+    };
+    let remote = Remote::open(fetch, 10_000, Vec::new(), options).unwrap();
+    let exited = remote.exit_flag();
