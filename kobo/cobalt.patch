+#[test]
+fn a_crash_between_the_two_renames_is_discarded_on_the_next_open() {
+    let dir = scratch("crash-between");
+    let (_card, policy) = Card::policy(u64::MAX, 0);
+    let (downloads, _lines) = downloads(&dir, policy);
+    let old = downloads.begin("shelf", URL, Some(3_000), BLOCK).unwrap();
+    assert!(old.write(0, &block(0, 3_000)).unwrap());
+    old.flush().unwrap();
+    drop(old);
+    // What a crash leaves: the new data in place, the old sidecar beside it.
+    let (data, sidecar) = pair(&dir);
+    let staged = data.with_extension("new");
+    std::fs::write(&staged, vec![0_u8; 3_000]).unwrap();
+    std::fs::rename(&staged, &data).unwrap();
+    assert!(
+        downloads.progress("shelf", &[URL.to_owned()]).is_empty(),
+        "a mixed pair is listed"
+    );
+    assert!(downloads.begin("shelf", URL, None, BLOCK).is_none());
+    assert!(!data.exists() && !sidecar.exists(), "the pair was kept");
+    let fresh = downloads.begin("shelf", URL, Some(3_000), BLOCK).unwrap();
+    assert!(!fresh.has(0));
+}
