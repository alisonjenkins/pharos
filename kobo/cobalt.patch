+    /// What an application asks in order to keep decoded only the pictures
+    /// near the place being read.
+    #[must_use]
+    pub fn pictures_at(&self) -> BTreeMap<&str, Locator> {
+        let mut at = BTreeMap::new();
+        for (index, block) in self.document.blocks.iter().enumerate() {
+            if let (Block::Picture { name, .. }, Ok(block)) = (block, Locator::try_from(index)) {
+                at.entry(name.as_str()).or_insert(block);
+            }
+        }
+        for (index, rich) in &self.document.rich {
+            let Ok(block) = Locator::try_from(*index) else {
+                continue;
+            };
+            for span in &rich.spans {
+                if let Some(name) = &span.formula {
+                    let first = at.entry(name.as_str()).or_insert(block);
+                    *first = (*first).min(block);
+                }
+            }
+        }
+        at
+    }
