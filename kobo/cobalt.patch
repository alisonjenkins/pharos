+#[test]
+fn an_interrupted_replacement_does_not_hold_the_budget_against_another_book() {
+    const OTHER: &str = "https://books.example/Audio/bbb/universal?api_key=old&static=true";
+    let dir = scratch("interrupted-budget");
+    let (_card, policy) = Card::policy(5_000, 0);
+    let (downloads, _lines) = downloads(&dir, policy);
+    let old = downloads.begin("shelf", URL, Some(3_000), BLOCK).unwrap();
+    assert!(old.write(0, &block(0, 3_000)).unwrap());
+    old.flush().unwrap();
+    drop(old);
+    // New data beside the old sidecar, as a stop between the renames leaves.
+    let (data, sidecar) = pair(&dir);
+    let staged = data.with_extension("new");
+    std::fs::write(&staged, vec![0_u8; 3_000]).unwrap();
+    std::fs::rename(&staged, &data).unwrap();
+    // The pair is junk and partial, so eviction would never take it; it must
+    // not count against the budget.
+    assert!(downloads
+        .begin("shelf", OTHER, Some(3_000), BLOCK)
+        .is_some());
+    assert!(!data.exists() && !sidecar.exists(), "the junk pair stayed");
+}
