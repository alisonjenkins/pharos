diff --git a/crates/kobo-audio/src/remote.rs b/crates/kobo-audio/src/remote.rs
new file mode 100644
index 0000000..3cfa016
--- /dev/null
+++ b/crates/kobo-audio/src/remote.rs
@@ -0,0 +1,652 @@
+//! A book read over the network in ranges, through a small shared cache.
+//!
+//! A multi-hour audiobook is hundreds of megabytes, and the reader has 1 GB
+//! for everything, so the file is never held whole. It is read in fixed
+//! blocks, at most [`RemoteOptions::resident_blocks`] of them held at once,
+//! and a background thread keeps the blocks after the listener's place
+//! fetched so the audio thread is not the one waiting on Wi-Fi.
+//!
+//! Reads are random access: an MPEG-4 book often keeps its index at the end,
+//! and the probe reads that before the first sound.
+
+use std::collections::HashMap;
+use std::fmt;
+use std::io::{self, Read, Seek, SeekFrom};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Condvar, Mutex, MutexGuard, PoisonError};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use symphonia::core::io::MediaSource;
+
+use crate::store::BlockStore;
+
+/// Why one range could not be fetched.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum FetchFailure {
+    /// Worth asking again: the network or the server may come back.
+    Transient,
+    /// The server answered and will not give this range: a refusal, a
+    /// missing file, or a whole-document reply where a range was asked for.
+    Refused,
+}
+
+/// Fetches `len` bytes of the resource starting at `offset`. Answers exactly
+/// `len` bytes, or fewer only for the last block.
+pub type RangeFetch = Arc<dyn Fn(u64, u32) -> Result<Vec<u8>, FetchFailure> + Send + Sync>;
+
+/// How the cache is shaped and how patient it is with the network.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct RemoteOptions {
+    pub block_bytes: u32,
+    /// The most blocks held at once. `block_bytes * resident_blocks` is the
+    /// whole of what a remote book costs in memory.
+    pub resident_blocks: usize,
+    /// Blocks after the read position the background thread keeps fetched.
+    pub ahead_blocks: u64,
+    /// Blocks before the read position kept from eviction, for short skips
+    /// back.
+    pub behind_blocks: u64,
+    /// Waits between attempts at a block; the last repeats.
+    pub retry_delays: Vec<Duration>,
+    /// How long one block is retried before the network counts as lost.
+    pub give_up_after: Duration,
+    /// How long the whole-file download rests after the network or the disk
+    /// failed it, before it tries again. Playback is not held up by this: the
+    /// blocks it needs are fetched whatever the download is doing.
+    pub background_pause: Duration,
+}
+
+impl Default for RemoteOptions {
+    fn default() -> Self {
+        Self {
+            block_bytes: 256 * 1024,
+            // 8 MiB resident: flat memory for any length of book.
+            resident_blocks: 32,
+            // About 6 MiB, which is several minutes of a spoken-word book:
+            // long enough to ride out a Wi-Fi power-save nap.
+            ahead_blocks: 24,
+            behind_blocks: 2,
+            retry_delays: vec![
+                Duration::from_millis(500),
+                Duration::from_secs(1),
+                Duration::from_secs(2),
+                Duration::from_secs(4),
+            ],
+            give_up_after: Duration::from_secs(30),
+            // Long enough that a reader out of Wi-Fi range is not asking the
+            // radio every few seconds for a download nobody is waiting on.
+            background_pause: Duration::from_secs(60),
+        }
+    }
+}
+
+/// What the cache has done, for tests and for whoever diagnoses a stall.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct RemoteStats {
+    pub fetches: u64,
+    pub failed_fetches: u64,
+    pub evictions: u64,
+    pub resident_bytes: usize,
+    pub peak_resident_bytes: usize,
+    /// Blocks read back from the download on disk.
+    pub disk_reads: u64,
+}
+
+/// Why a read of a remote book failed, carried inside the `io::Error` the
+/// decoder sees so the book can tell it from damage.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum RemoteFault {
+    /// The network stayed away past the retry budget.
+    Lost,
+    /// The server refused a range.
+    Refused,
+}
+
+impl fmt::Display for RemoteFault {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(match self {
+            Self::Lost => "the network was lost while streaming",
+            Self::Refused => "the server refused a range of the stream",
+        })
+    }
+}
+
+impl std::error::Error for RemoteFault {}
+
+impl RemoteFault {
+    fn into_io(self) -> io::Error {
+        let kind = match self {
+            Self::Lost => io::ErrorKind::NotConnected,
+            Self::Refused => io::ErrorKind::PermissionDenied,
+        };
+        io::Error::new(kind, self)
+    }
+
+    /// The fault an `io::Error` from a remote reader carries, if any.
+    pub(crate) fn of(error: &io::Error) -> Option<Self> {
+        error
+            .get_ref()
+            .and_then(|inner| inner.downcast_ref::<Self>())
+            .copied()
+    }
+}
+
+struct Block {
+    bytes: Arc<[u8]>,
+    /// The cache clock when this block was last read or stored.
+    used: u64,
+}
+
+#[derive(Default)]
+struct Cache {
+    blocks: HashMap<u64, Block>,
+    clock: u64,
+    /// The block the most recent read wanted; read-ahead starts here.
+    wanted: u64,
+    /// Set when a block could not be had within the retry budget. Cleared
+    /// when a new reader opens, which is a listener pressing Play again.
+    lost: bool,
+    refused: bool,
+    closed: bool,
+    /// Until when the whole-file download rests, if it does.
+    background_after: Option<Instant>,
+    stats: RemoteStats,
+}
+
+struct Shared {
+    fetch: RangeFetch,
+    total: u64,
+    options: RemoteOptions,
+    cache: Mutex<Cache>,
+    changed: Condvar,
+    ahead_exited: AtomicBool,
+    /// The download on disk, when this book is being kept.
+    disk: Option<BlockStore>,
+}
+
+/// One remote resource: its cache and the read-ahead thread that fills it.
+/// Dropping it stops the thread.
+pub struct Remote {
+    shared: Arc<Shared>,
+}
+
+impl fmt::Debug for Remote {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Remote")
+            .field("total", &self.shared.total)
+            .finish_non_exhaustive()
+    }
+}
+
+impl Remote {
+    /// A resource `total` bytes long, read through `fetch`. `first` is the
+    /// opening block if the caller already fetched it, as the request that
+    /// found out the total did.
+    ///
+    /// # Errors
+    /// The read-ahead thread could not be started.
+    pub fn open(
+        fetch: RangeFetch,
+        total: u64,
+        first: Vec<u8>,
+        options: RemoteOptions,
+    ) -> io::Result<Self> {
+        Self::start(fetch, total, first, options, None)
+    }
+
+    /// A resource kept on disk in `disk`: blocks already there are read from
+    /// it, and a background download fetches the rest, from the read position
+    /// on and then from the start. Its length and block size are the
+    /// download's own.
+    ///
+    /// # Errors
+    /// The read-ahead thread could not be started.
+    pub fn open_stored(
+        fetch: RangeFetch,
+        disk: BlockStore,
+        first: Vec<u8>,
+        options: RemoteOptions,
+    ) -> io::Result<Self> {
+        let options = RemoteOptions {
+            block_bytes: disk.block_bytes(),
+            ..options
+        };
+        let total = disk.total();
+        Self::start(fetch, total, first, options, Some(disk))
+    }
+
+    fn start(
+        fetch: RangeFetch,
+        total: u64,
+        first: Vec<u8>,
+        options: RemoteOptions,
+        disk: Option<BlockStore>,
+    ) -> io::Result<Self> {
+        let options = RemoteOptions {
+            block_bytes: options.block_bytes.max(1),
+            resident_blocks: options.resident_blocks.max(1),
+            ..options
+        };
+        let shared = Arc::new(Shared {
+            fetch,
+            total,
+            options,
+            cache: Mutex::new(Cache::default()),
+            changed: Condvar::new(),
+            ahead_exited: AtomicBool::new(false),
+            disk,
+        });
+        if !first.is_empty() && Some(first.len()) == shared.block_len(0) {
+            let bytes: Arc<[u8]> = first.into();
+            if let Some(disk) = &shared.disk {
+                // Best effort: a block that cannot be kept is still played.
+                let _kept = disk.write(0, &bytes);
+            }
+            let mut cache = shared.lock();
+            store(&shared, &mut cache, 0, bytes);
+        }
+        let ahead = Arc::clone(&shared);
+        thread::Builder::new()
+            .name("audio-read-ahead".to_owned())
+            .spawn(move || {
+                read_ahead(&ahead);
+                ahead.ahead_exited.store(true, Ordering::SeqCst);
+            })?;
+        Ok(Self { shared })
+    }
+
+    #[must_use]
+    pub fn total(&self) -> u64 {
+        self.shared.total
+    }
+
+    #[must_use]
+    pub fn stats(&self) -> RemoteStats {
+        self.shared.lock().stats
+    }
+
+    /// A new reader at the start, sharing this cache.
+    pub(crate) fn reader(&self) -> Reader {
+        {
+            let mut cache = self.shared.lock();
+            cache.lost = false;
+            cache.background_after = None;
+        }
+        self.shared.changed.notify_all();
+        Reader {
+            shared: Arc::clone(&self.shared),
+            position: 0,
+        }
+    }
+
+    /// Whether the read-ahead thread has returned.
+    #[cfg(test)]
+    pub(crate) fn exit_flag(&self) -> Arc<dyn Fn() -> bool + Send + Sync> {
+        let shared = Arc::clone(&self.shared);
+        Arc::new(move || shared.ahead_exited.load(Ordering::SeqCst))
+    }
+}
+
+impl Drop for Remote {
+    fn drop(&mut self) {
+        // Not joined: the thread may be inside a fetch that only the
+        // transport's own timeout ends, and the audio thread dropping a book
+        // must not wait on Wi-Fi. It returns as soon as that fetch does.
+        self.shared.lock().closed = true;
+        self.shared.changed.notify_all();
+    }
+}
+
+impl Shared {
+    fn lock(&self) -> MutexGuard<'_, Cache> {
+        self.cache.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+
+    fn block_count(&self) -> u64 {
+        self.total.div_ceil(u64::from(self.options.block_bytes))
+    }
+
+    fn block_start(&self, index: u64) -> u64 {
+        index.saturating_mul(u64::from(self.options.block_bytes))
+    }
+
+    /// How long block `index` is, or `None` past the end.
+    fn block_len(&self, index: u64) -> Option<usize> {
+        let start = self.block_start(index);
+        if start >= self.total {
+            return None;
+        }
+        let len = (self.total - start).min(u64::from(self.options.block_bytes));
+        usize::try_from(len).ok()
+    }
+
+    /// Block `index`, waiting for the read-ahead thread to fetch it.
+    fn block(&self, index: u64) -> io::Result<Arc<[u8]>> {
+        // A safety net for a read-ahead thread that has died: it always
+        // answers within the retry budget otherwise.
+        let deadline = Instant::now() + self.options.give_up_after + Duration::from_secs(15);
+        let mut cache = self.lock();
+        if cache.wanted != index {
+            cache.wanted = index;
+            self.changed.notify_all();
+        }
+        loop {
+            cache.clock = cache.clock.wrapping_add(1);
+            let clock = cache.clock;
+            if let Some(block) = cache.blocks.get_mut(&index) {
+                block.used = clock;
+                return Ok(Arc::clone(&block.bytes));
+            }
+            if let Some(disk) = self.disk.as_ref().filter(|disk| disk.has(index)) {
+                let bytes: Arc<[u8]> = disk.read(index)?.into();
+                cache.stats.disk_reads = cache.stats.disk_reads.saturating_add(1);
+                store(self, &mut cache, index, Arc::clone(&bytes));
+                return Ok(bytes);
+            }
+            if cache.refused {
+                return Err(RemoteFault::Refused.into_io());
+            }
+            if cache.lost || cache.closed {
+                return Err(RemoteFault::Lost.into_io());
+            }
+            let now = Instant::now();
+            if now >= deadline {
+                return Err(RemoteFault::Lost.into_io());
+            }
+            cache = self
+                .changed
+                .wait_timeout(cache, deadline - now)
+                .map_or_else(|poisoned| poisoned.into_inner().0, |(guard, _)| guard);
+        }
+    }
+
+    fn on_disk(&self, index: u64) -> bool {
+        self.disk.as_ref().is_some_and(|disk| disk.has(index))
+    }
+
+    /// The first block in the read-ahead window held neither in memory nor
+    /// on disk.
+    fn window_missing(&self, cache: &Cache) -> Option<u64> {
+        let end = cache
+            .wanted
+            .saturating_add(self.options.ahead_blocks)
+            .saturating_add(1)
+            .min(self.block_count());
+        (cache.wanted..end).find(|index| !cache.blocks.contains_key(index) && !self.on_disk(*index))
+    }
+
+    /// The next block to fetch, and whether it is for the download rather
+    /// than for playback. Playback's come first.
+    fn next_missing(&self, cache: &Cache) -> Option<(u64, bool)> {
+        if let Some(index) = self.window_missing(cache) {
+            return Some((index, false));
+        }
+        let disk = self.disk.as_ref()?;
+        if cache
+            .background_after
+            .is_some_and(|after| Instant::now() < after)
+        {
+            return None;
+        }
+        disk.missing_from(cache.wanted).map(|index| (index, true))
+    }
+
+    /// Whether `index` is in the window kept from eviction.
+    fn protected(&self, cache: &Cache, index: u64) -> bool {
+        let low = cache.wanted.saturating_sub(self.options.behind_blocks);
+        let high = cache.wanted.saturating_add(self.options.ahead_blocks);
+        (low..=high).contains(&index)
+    }
+}
+
+/// Stores a fetched block, evicting the least recently used outside the
+/// window around the read position first.
+fn store(shared: &Shared, cache: &mut Cache, index: u64, bytes: Arc<[u8]>) {
+    while cache.blocks.len() >= shared.options.resident_blocks {
+        let victim = cache
+            .blocks
+            .iter()
+            .filter(|(at, _)| !shared.protected(cache, **at))
+            .min_by_key(|(_, block)| block.used)
+            .or_else(|| cache.blocks.iter().min_by_key(|(_, block)| block.used))
+            .map(|(at, _)| *at);
+        let Some(victim) = victim else { break };
+        if let Some(evicted) = cache.blocks.remove(&victim) {
+            cache.stats.resident_bytes = cache
+                .stats
+                .resident_bytes
+                .saturating_sub(evicted.bytes.len());
+            cache.stats.evictions = cache.stats.evictions.saturating_add(1);
+        }
+    }
+    cache.clock = cache.clock.wrapping_add(1);
+    cache.stats.resident_bytes = cache.stats.resident_bytes.saturating_add(bytes.len());
+    cache.stats.peak_resident_bytes = cache
+        .stats
+        .peak_resident_bytes
+        .max(cache.stats.resident_bytes);
+    let used = cache.clock;
+    if let Some(replaced) = cache.blocks.insert(index, Block { bytes, used }) {
+        cache.stats.resident_bytes = cache
+            .stats
+            .resident_bytes
+            .saturating_sub(replaced.bytes.len());
+    }
+}
+
+/// What a fetch with retries came to.
+enum Outcome {
+    Got(Arc<[u8]>),
+    Lost,
+    Refused,
+    Closed,
+    /// The reader moved away from this block while it was being retried.
+    Moved,
+}
+
+fn read_ahead(shared: &Shared) {
+    loop {
+        let (index, background) = {
+            let mut cache = shared.lock();
+            loop {
+                if cache.closed {
+                    return;
+                }
+                if !cache.lost && !cache.refused {
+                    if let Some(next) = shared.next_missing(&cache) {
+                        break next;
+                    }
+                }
+                // A resting download wakes by itself; everything else waits
+                // to be told something changed.
+                let resting = cache
+                    .background_after
+                    .map(|after| after.saturating_duration_since(Instant::now()))
+                    .filter(|left| !left.is_zero());
+                cache = match resting {
+                    Some(left) => shared
+                        .changed
+                        .wait_timeout(cache, left)
+                        .map_or_else(|poisoned| poisoned.into_inner().0, |(guard, _)| guard),
+                    None => shared
+                        .changed
+                        .wait(cache)
+                        .unwrap_or_else(PoisonError::into_inner),
+                };
+            }
+        };
+        if background && !shared.disk.as_ref().is_some_and(BlockStore::has_room) {
+            shared.lock().background_after = Some(Instant::now() + shared.options.background_pause);
+            continue;
+        }
+        let outcome = fetch_retrying(shared, index, background);
+        let kept = match (&outcome, shared.disk.as_ref()) {
+            (Outcome::Got(bytes), Some(disk)) => match disk.write(index, bytes) {
+                Ok(kept) => kept,
+                Err(error) => {
+                    disk.note_write_failure(index, &error);
+                    false
+                }
+            },
+            _ => true,
+        };
+        let mut cache = shared.lock();
+        match outcome {
+            Outcome::Got(bytes) => {
+                if !kept {
+                    cache.background_after = Some(Instant::now() + shared.options.background_pause);
+                }
+                // A block fetched for the download alone is on disk and is
+                // read from there when playback arrives.
+                if !background || shared.disk.is_none() {
+                    store(shared, &mut cache, index, bytes);
+                }
+            }
+            Outcome::Lost if background => {
+                cache.background_after = Some(Instant::now() + shared.options.background_pause);
+            }
+            Outcome::Lost => cache.lost = true,
+            Outcome::Refused => cache.refused = true,
+            Outcome::Closed => return,
+            Outcome::Moved => {}
+        }
+        drop(cache);
+        shared.changed.notify_all();
+    }
+}
+
+fn fetch_retrying(shared: &Shared, index: u64, background: bool) -> Outcome {
+    let Some(len) = shared.block_len(index) else {
+        return Outcome::Refused;
+    };
+    let Ok(asked) = u32::try_from(len) else {
+        return Outcome::Refused;
+    };
+    let offset = shared.block_start(index);
+    let started = Instant::now();
+    let mut attempt = 0_usize;
+    loop {
+        let fetched = (shared.fetch)(offset, asked);
+        let delay = shared
+            .options
+            .retry_delays
+            .get(attempt)
+            .or_else(|| shared.options.retry_delays.last())
+            .copied()
+            .unwrap_or(Duration::ZERO);
+        let gives_up = started.elapsed().saturating_add(delay) > shared.options.give_up_after;
+        {
+            let mut cache = shared.lock();
+            cache.stats.fetches = cache.stats.fetches.saturating_add(1);
+            if cache.closed {
+                return Outcome::Closed;
+            }
+            let failure = match &fetched {
+                Ok(bytes) if bytes.len() == len => None,
+                Err(FetchFailure::Refused) => Some("the server refused the range".to_owned()),
+                // A short or long body is a reply cut off or a server that
+                // changed its mind about ranges; both may be passing.
+                Ok(bytes) => Some(format!("got {} bytes, asked for {len}", bytes.len())),
+                Err(FetchFailure::Transient) => Some("the network failed".to_owned()),
+            };
+            if let Some(why) = failure {
+                cache.stats.failed_fetches = cache.stats.failed_fetches.saturating_add(1);
+                let refused = matches!(fetched, Err(FetchFailure::Refused));
+                if let Some(disk) = &shared.disk {
+                    disk.note_fetch_failure(offset, &why, refused || gives_up);
+                }
+                if refused {
+                    return Outcome::Refused;
+                }
+            } else if let Ok(bytes) = fetched {
+                return Outcome::Got(bytes.into());
+            }
+        }
+        if gives_up {
+            return Outcome::Lost;
+        }
+        attempt = attempt.saturating_add(1);
+        // Waited on the condition rather than slept, so dropping the book
+        // ends the wait at once.
+        let until = Instant::now() + delay;
+        let mut cache = shared.lock();
+        loop {
+            if cache.closed {
+                return Outcome::Closed;
+            }
+            // Playback outranks the download: a block it is waiting for ends
+            // the wait on a far one, and one it has moved away from ends the
+            // wait on a near one.
+            let abandoned = if background {
+                shared.window_missing(&cache).is_some()
+            } else {
+                !shared.protected(&cache, index)
+            };
+            if abandoned {
+                return Outcome::Moved;
+            }
+            let now = Instant::now();
+            if now >= until {
+                break;
+            }
+            cache = shared
+                .changed
+                .wait_timeout(cache, until - now)
+                .map_or_else(|poisoned| poisoned.into_inner().0, |(guard, _)| guard);
+        }
+    }
+}
+
+/// One position in a remote resource. Several share one cache.
+pub(crate) struct Reader {
+    shared: Arc<Shared>,
+    position: u64,
+}
+
+impl Read for Reader {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        if buf.is_empty() || self.position >= self.shared.total {
+            return Ok(0);
+        }
+        let block_bytes = u64::from(self.shared.options.block_bytes);
+        let index = self.position / block_bytes;
+        let block = self.shared.block(index)?;
+        let within = usize::try_from(self.position % block_bytes)
+            .map_err(|_| io::Error::from(io::ErrorKind::InvalidInput))?;
+        let available = block.get(within..).unwrap_or_default();
+        let count = available.len().min(buf.len());
+        if let (Some(into), Some(from)) = (buf.get_mut(..count), available.get(..count)) {
+            into.copy_from_slice(from);
+        }
+        self.position = self.position.saturating_add(count as u64);
+        Ok(count)
+    }
+}
+
+impl Seek for Reader {
+    fn seek(&mut self, to: SeekFrom) -> io::Result<u64> {
+        let target = match to {
+            SeekFrom::Start(at) => Some(at),
+            SeekFrom::End(delta) => self.shared.total.checked_add_signed(delta),
+            SeekFrom::Current(delta) => self.position.checked_add_signed(delta),
+        };
+        let target = target
+            .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "seek before start"))?;
+        self.position = target;
+        Ok(target)
+    }
+}
+
+impl MediaSource for Reader {
+    fn is_seekable(&self) -> bool {
+        true
+    }
+
+    fn byte_len(&self) -> Option<u64> {
+        Some(self.shared.total)
+    }
+}
