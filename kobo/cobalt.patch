+    #[test]
+    fn a_large_book_opens_from_a_small_part_of_it() {
+        let book = a_large_illustrated_book();
+        let (result, reads) = drive(&book);
+        let Ok(Next::Done(document, measured, size)) = result else {
+            panic!("an open book, not {result:?}");
+        };
+
+        assert_eq!(size, book.len());
+        assert!(reads
+            .iter()
+            .all(|(_, length)| *length as usize <= MAX_SHELF_CHUNK));
+        let read: usize = reads.iter().map(|(_, length)| *length as usize).sum();
+        assert!(
+            read < book.len() / 8,
+            "{read} of {} bytes read to open the book",
+            book.len()
+        );
+
+        assert!(document.images.is_empty(), "no picture is held whole");
+        assert!(
+            document.places.is_empty(),
+            "the places moved to the measures"
+        );
+        let pictures = document
+            .blocks
+            .iter()
+            .filter(|block| matches!(block, Block::Picture { .. }))
+            .count();
+        assert_eq!(pictures, PLATES + 1);
+        assert_eq!(
+            measured.len(),
+            PLATES,
+            "the false picture is left unmeasured"
+        );
+        for index in 0..PLATES {
+            let width = u32::try_from(100 + index).expect("a width");
+            let (dimensions, location) = measured[&format!("OEBPS/p/{index}.png")];
+            assert_eq!(dimensions, (width, 300));
+            let plate =
+                super::unpack(&book[location.at..location.end], &location).expect("the plate");
+            assert_eq!(plate.len(), PLATE_BYTES);
+        }
+    }
