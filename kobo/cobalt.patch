+        !store.write(1, &bytes[1_024..2_048]).unwrap(),
+        "wrote under the floor"
+    );
+    assert!(!store.has(1));
+    assert!(!store.has_room());
+    assert_eq!(downloads.stats().skipped_low_space, 2);
+    assert!(said(&lines, "downloads: pause"));
