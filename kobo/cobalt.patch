+#[test]
+fn the_budget_evicts_the_least_recently_played_complete_download() {
+    let dir = scratch("budget");
+    let (card, policy) = Card::policy(3_000, 0);
+    let (downloads, lines) = downloads(&dir, policy);
+    let urls: Vec<String> = ["old", "mid", "new"]
+        .iter()
+        .map(|name| format!("https://books.example/Audio/{name}/universal"))
+        .collect();
+    for (at, url) in urls.iter().enumerate() {
+        card.clock.store(10 + at as u64, Ordering::SeqCst);
+        fill(&downloads, url, 1_000);
+    }
+    let have = |url: &String| {
+        !downloads
+            .progress("shelf", std::slice::from_ref(url))
+            .is_empty()
+    };
+
+    // The oldest is open, so the next oldest goes instead.
+    card.clock.store(20, Ordering::SeqCst);
+    let held = downloads.begin("shelf", &urls[0], None, BLOCK).unwrap();
+    let fourth = "https://books.example/Audio/fourth/universal".to_owned();
+    let store = downloads
+        .begin("shelf", &fourth, Some(1_000), BLOCK)
+        .unwrap();
+    assert!(have(&urls[0]) && !have(&urls[1]) && have(&urls[2]));
+    assert_eq!(downloads.stats().evicted, 1);
+    assert!(said(&lines, "downloads: evict"));
+    assert!(said(&lines, "reason=over budget"));
+    drop(held);
+
+    // A half-fetched download is not evicted to make room.
+    assert!(!store.is_complete());
+    let fifth = "https://books.example/Audio/fifth/universal".to_owned();
+    let big = downloads.begin("shelf", &fifth, Some(2_500), BLOCK);
+    assert!(
+        big.is_none(),
+        "found room by evicting the open or the partial"
+    );
+    assert!(have(&fourth), "evicted a partial download");
+    assert_eq!(downloads.stats().skipped_budget, 1);
+    // Failing to make room left the complete ones evicted only as far as it went.
+    assert!(downloads.stats().evicted >= 2);
+}
