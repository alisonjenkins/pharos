+
+#[test]
+fn a_fetch_that_fails_a_few_times_then_recovers_is_read_through() {
+    let bytes = pattern(20_000);
+    let failures = Arc::new(AtomicUsize::new(3));
+    let fetch: RangeFetch = {
+        let bytes = Arc::clone(&bytes);
+        let failures = Arc::clone(&failures);
+        Arc::new(move |offset, len| {
+            if offset == 8_192
+                && failures
+                    .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |left| {
+                        left.checked_sub(1)
+                    })
+                    .is_ok()
+            {
+                return Err(FetchFailure::Transient);
+            }
+            let start = usize::try_from(offset).unwrap();
+            Ok(bytes[start..(start + len as usize).min(bytes.len())].to_vec())
+        })
+    };
+    let remote = Remote::open(fetch, 20_000, Vec::new(), quick(4_096)).unwrap();
+    let mut all = Vec::new();
+    remote.reader().read_to_end(&mut all).unwrap();
+    assert_eq!(all, *bytes);
+    assert_eq!(remote.stats().failed_fetches, 3);
+}
+
+#[test]
+fn a_network_that_stays_away_is_reported_lost_and_a_new_reader_tries_again() {
+    let bytes = pattern(20_000);
+    let down = Arc::new(AtomicBool::new(true));
+    let fetch: RangeFetch = {
+        let bytes = Arc::clone(&bytes);
+        let down = Arc::clone(&down);
+        Arc::new(move |offset, len| {
+            if down.load(Ordering::SeqCst) {
+                return Err(FetchFailure::Transient);
+            }
+            let start = usize::try_from(offset).unwrap();
+            Ok(bytes[start..(start + len as usize).min(bytes.len())].to_vec())
+        })
+    };
+    let remote = Remote::open(fetch, 20_000, Vec::new(), quick(4_096)).unwrap();
+    let mut buffer = [0; 10];
+    let error = remote.reader().read(&mut buffer).unwrap_err();
+    assert_eq!(RemoteFault::of(&error), Some(RemoteFault::Lost), "{error}");
+    down.store(false, Ordering::SeqCst);
+    let mut all = Vec::new();
+    remote.reader().read_to_end(&mut all).unwrap();
+    assert_eq!(all, *bytes);
+}
+
+#[test]
+fn a_refused_range_is_not_retried() {
+    let fetch: RangeFetch = Arc::new(|_, _| Err(FetchFailure::Refused));
+    let remote = Remote::open(fetch, 20_000, Vec::new(), quick(4_096)).unwrap();
+    let mut buffer = [0; 10];
+    let error = remote.reader().read(&mut buffer).unwrap_err();
+    assert_eq!(
+        RemoteFault::of(&error),
+        Some(RemoteFault::Refused),
+        "{error}"
+    );
+    assert_eq!(remote.stats().fetches, 1);
+}
