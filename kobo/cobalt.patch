+fn pair(dir: &Path) -> (PathBuf, PathBuf) {
+    let key = key_of(URL);
+    (
+        dir.join("shelf").join(format!("{key}.{DATA_SUFFIX}")),
+        dir.join("shelf").join(format!("{key}.{SIDECAR_SUFFIX}")),
+    )
