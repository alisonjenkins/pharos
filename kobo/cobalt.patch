+const BLOCK: u32 = 1_024;
+
+fn pattern(len: usize) -> Arc<Vec<u8>> {
+    #[allow(clippy::cast_possible_truncation, reason = "a repeating byte pattern")]
+    Arc::new((0..len).map(|at| (at % 251) as u8).collect())
+}
+
+fn scratch(name: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("kobo-downloads-{name}-{}", std::process::id()));
+    let _ignored = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    dir
+}
+
+/// A policy with a card as full as the test says and a clock it winds.
+struct Card {
+    free: Arc<AtomicU64>,
+    clock: Arc<AtomicU64>,
+}
+
+impl Card {
+    fn policy(budget: u64, floor: u64) -> (Self, DownloadPolicy) {
+        let free = Arc::new(AtomicU64::new(u64::MAX));
+        let clock = Arc::new(AtomicU64::new(1));
+        let policy = DownloadPolicy {
+            budget_bytes: budget,
+            min_free_bytes: floor,
+            free_space: {
+                let free = Arc::clone(&free);
+                Arc::new(move |_| Some(free.load(Ordering::SeqCst)))
+            },
+            now: {
+                let clock = Arc::clone(&clock);
+                Arc::new(move || clock.load(Ordering::SeqCst))
+            },
+        };
+        (Self { free, clock }, policy)
+    }
+}
+
+type Lines = Arc<Mutex<Vec<String>>>;
+
+fn downloads(dir: &Path, policy: DownloadPolicy) -> (Downloads, Lines) {
+    let lines: Lines = Arc::default();
+    let sink = Arc::clone(&lines);
+    let downloads = Downloads::new(dir.to_path_buf(), policy)
+        .with_log(move |line| sink.lock().unwrap().push(line.to_owned()));
+    (downloads, lines)
+}
+
+fn said(lines: &Lines, needle: &str) -> bool {
+    lines
+        .lock()
+        .unwrap()
+        .iter()
+        .any(|line| line.contains(needle))
+}
+
+fn eventually(what: &str, done: impl Fn() -> bool) {
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while !done() {
+        assert!(Instant::now() < deadline, "never: {what}");
+        std::thread::sleep(Duration::from_millis(5));
+    }
+}
+
+/// Writes every block of a made-up book of `total` bytes.
+fn fill(downloads: &Downloads, url: &str, total: u64) {
+    let store = downloads.begin("shelf", url, Some(total), BLOCK).unwrap();
+    let bytes = pattern(usize::try_from(total).unwrap());
+    let mut at = 0;
+    let mut index = 0;
+    while at < bytes.len() {
+        let end = (at + BLOCK as usize).min(bytes.len());
+        assert!(store.write(index, &bytes[at..end]).unwrap());
+        at = end;
+        index += 1;
+    }
+    assert!(store.is_complete());
+}
+
+fn failing(calls: Arc<AtomicU64>) -> RangeFetch {
+    Arc::new(move |_, _| {
+        calls.fetch_add(1, Ordering::SeqCst);
+        Err(FetchFailure::Transient)
+    })
+}
