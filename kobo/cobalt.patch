+fn decode_downloads(reader: &mut Reader<'_>) -> Result<DeviceResult, ProtocolError> {
+    let count = usize::from(reader.u16()?);
+    if count > MAX_DOWNLOAD_URLS {
+        return Err(ProtocolError::InvalidValue("download listing"));
+    }
+    let mut entries = Vec::with_capacity(count);
+    for _ in 0..count {
+        let entry = DownloadEntry {
+            url: reader.string()?,
+            have: reader.u64()?,
+            total: reader.u64()?,
+        };
+        if !valid_download_url(&entry.url) || entry.have > entry.total {
+            return Err(ProtocolError::InvalidValue("download listing"));
+        }
+        entries.push(entry);
+    }
