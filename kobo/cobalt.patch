+#[test]
+fn downloads_are_refused_below_their_version_and_when_malformed() {
+    let url = "https://books.example/Audio/aaa/universal".to_owned();
+    let below = DOWNLOADS_VERSION - 1;
+    for message in [
+        Message::DeviceRequest(DeviceRequest::ListDownloads {
+            urls: vec![url.clone()],
+        }),
+        Message::DeviceRequest(DeviceRequest::RemoveDownload { url: url.clone() }),
+        Message::DeviceResult(DeviceResult::Downloads {
+            entries: Vec::new(),
+        }),
+    ] {
+        let frame = Frame {
+            version: below,
+            request_id: 4,
+            message,
+        };
+        assert_eq!(
+            encode(&frame).err(),
+            Some(ProtocolError::UnsupportedVersion(below))
+        );
+        // A frame built at the new version and relabelled as the old one is
+        // refused on reading, not misread as something else.
+        let mut bytes = encode(&Frame {
+            version: DOWNLOADS_VERSION,
+            ..frame
+        })
+        .expect("encode");
+        let at = bytes.iter().position(|byte| *byte == DOWNLOADS_VERSION);
+        if let Some(at) = at {
+            bytes[at] = below;
+            assert!(decode(&bytes).is_err());
+        }
+    }
+    for bad in [
+        "http://books.example/a",
+        "file:///etc/passwd",
+        "https://books.example/a\nb",
+    ] {
+        for message in [
+            Message::DeviceRequest(DeviceRequest::RemoveDownload {
+                url: bad.to_owned(),
+            }),
+            Message::DeviceRequest(DeviceRequest::ListDownloads {
+                urls: vec![bad.to_owned()],
+            }),
+        ] {
+            let frame = Frame {
+                version: DOWNLOADS_VERSION,
+                request_id: 4,
+                message,
+            };
+            assert!(encode(&frame).is_err(), "{bad}");
+        }
+    }
+    let too_many = Frame {
+        version: DOWNLOADS_VERSION,
+        request_id: 4,
+        message: Message::DeviceRequest(DeviceRequest::ListDownloads {
+            urls: vec![url; MAX_DOWNLOAD_URLS + 1],
+        }),
+    };
+    assert!(encode(&too_many).is_err());
+    let impossible = Frame {
+        version: DOWNLOADS_VERSION,
+        request_id: 4,
+        message: Message::DeviceResult(DeviceResult::Downloads {
+            entries: vec![DownloadEntry {
+                url: "https://books.example/a".to_owned(),
+                have: 9,
+                total: 3,
+            }],
+        }),
+    };
+    assert!(encode(&impossible).is_err());
+}
