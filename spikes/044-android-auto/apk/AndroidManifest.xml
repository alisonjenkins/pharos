<?xml version="1.0" encoding="utf-8"?>
<!-- Spike 044: an app whose only code is a Rust-generated class and a Rust
     library. Android Auto finds it through the MediaBrowserService filter. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.alisonjenkins.pharos.auto"
    android:versionCode="1"
    android:versionName="spike-044">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application
        android:label="Pharos (spike)"
        android:extractNativeLibs="true"
        android:allowBackup="false">
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <service
            android:name="com.alisonjenkins.pharos.auto.PharosMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
